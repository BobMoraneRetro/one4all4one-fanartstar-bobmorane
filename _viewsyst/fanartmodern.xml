<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${firstsystemimagedef} : Vues système modern 1 et 2 : fanart custom, sinon fresh, sinon default.png (définie dans theme.xml)
	${path_common} : dossier _common du thème (définie dans theme.xml)
	${path_syst_logo} : dossier des logos des systèmes (définie dans theme.xml ; valeur selon l option « AVANCÉ - Emplacement des logos des systèmes »)
-->
<theme>
	<formatVersion>7</formatVersion>
	<include>${themePath}/_systemmedia/description/${system.theme}.xml</include>
	<view name="system">
		<imagegrid name="imagegrid">
			<scrollSound ifSubset="gamewheelsound:bulle">${path_common}/scrollsound/bulle.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clic">${path_common}/scrollsound/clic.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clicgrave">${path_common}/scrollsound/clicgrave.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:frottement">${path_common}/scrollsound/frottement.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:poc">${path_common}/scrollsound/poc.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360blade">${path_common}/scrollsound/xbox360-BladeSwitch_1.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360onglet">${path_common}/scrollsound/xbox360-tab_Switch.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360focus">${path_common}/scrollsound/xbox360-vk_Focus.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360touche">${path_common}/scrollsound/xbox360-vk_Select.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360retour">${path_common}/scrollsound/xbox360-btn_backG.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360selection">${path_common}/scrollsound/xbox360-snd_buttonselect.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:wheelclic">${path_common}/scrollsound/wheelclic.wav</scrollSound>
			<pos>0 0.4</pos>
			<size>1 0.51</size>
			<scrollDirection>horizontal</scrollDirection>
			<autoLayout>6 1</autoLayout>
			<padding>0.03 0.1 0.03 0.12</padding>
			<margin>0.035 0.1</margin>
			<scrollbarColor>FFFFFFFF</scrollbarColor>
			<scrollbarCorner>0.5</scrollbarCorner>
			<scrollbarSize>0.01</scrollbarSize>
			<autoLayoutSelectedZoom>1.2</autoLayoutSelectedZoom>
			<centerSelection>false</centerSelection>
			<zIndex>50</zIndex>
			<itemTemplate>
				<container>
					<image name="thumb">
						<roundCorners>0.03</roundCorners>
						<pos>0.5 0.505</pos>
						<origin>0.5</origin>
						<minSize>1.15 1.39</minSize>
						<path>${firstsystemimagedef}</path>
						<zIndex>5</zIndex>
						<shader ifSubset="perfmachine:perfnormal">
							<path>:/shaders/blur.glsl</path>
							<pos>0 0</pos>
							<blur>10</blur>
							<zIndex>1</zIndex>
							<blurColor>000000</blurColor>
						</shader>
						<storyboard event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard event="activate">
							<animation property="color" to="FFFFFFFF" begin="" duration="150" mode="Linear"/>
							<animation property="scale" to="1.2" begin="" duration="350" mode="easeOut"/>
							<animation property="saturation" to="1" begin="" duration="150" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="color" to="858585ff" begin="" duration="250" mode="Linear"/>
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="saturation" to="0" begin="" duration="150" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="color" to="858585ff" begin="" duration="" mode="Linear"/>
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="saturation" to="0" begin="" duration="150" mode="Linear"/>
						</storyboard>
					</image>
					<image name="vignette">
						<roundCorners>0.03</roundCorners>
						<path>${themePath}/_viewsyst/fanartstar/vignette3.png</path>
						<pos>0.5 0.508</pos>
						<origin>0.5</origin>
						<minSize>1.16 1.41</minSize>
						<zIndex>5</zIndex>
						<storyboard event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard ifSubset="perfmachine:perfnormal" event="activate">
							<animation property="scale" to="1.2" begin="" duration="350" mode="easeOut"/>
							<animation property="color" from="858585ff" to="FFFFFFFF" begin="10" duration="150" mode="Linear" autoReverse="true" repeat="forever"/>
						</storyboard>
						<storyboard ifSubset="perfmachine:perflow" event="activate">
							<animation property="scale" to="1.2" begin="" duration="350" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="opacity" to="1" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="opacity" to="1" begin="" duration="" mode="Linear"/>
						</storyboard>
					</image>
					<image name="cadre">
						<path>${themePath}/_viewsyst/fanartstar/cadre.png</path>
						<linearSmooth>true</linearSmooth>
						<origin>0.5</origin>
						<pos>0.51 0.5</pos>
						<size>1.18 1.42</size>
						<zIndex>7</zIndex>
						<color>FFFFFFFF</color>
						<storyboard event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard ifSubset="perfmachine:perfnormal" event="activate">
							<animation property="color" to="FFFFFFFF" begin="" duration="150" mode="Linear"/>
							<animation property="scale" to="1.2" begin="" duration="350" mode="easeOut"/>
							<animation property="color" from="858585ff" to="FFFFFFFF" begin="10" duration="150" mode="Linear" autoReverse="true" repeat="forever"/>
						</storyboard>
						<storyboard ifSubset="perfmachine:perflow" event="activate">
							<animation property="scale" to="1.2" begin="" duration="350" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="opacity" to="1" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="opacity" to="1" begin="" duration="" mode="Linear"/>
						</storyboard>
					</image>
					<image name="shadowlogo" pos="0.51 0.5" origin="0.5" maxSize="1">
						<path>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
					"${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.svg",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.svg",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".svg")</path>
						<padding>3 3 -3 -3</padding>
						<color>000000</color>
						<zIndex>6</zIndex>
						<storyboard event="open">
						</storyboard>
						<storyboard event="activate">
							<animation property="scale" to="1.1" begin="" duration="350" mode="bump"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="scale" to="1" begin="" duration="350" mode="bump"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="scale" to="1" begin="" duration="350" mode="bump"/>
						</storyboard>
					</image>
					<image name="logo" extra="true" pos="0.51 0.5" origin="0.5" maxSize="1">
						<path>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
					"${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.svg",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.svg",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".svg")</path>
						<zIndex>7</zIndex>
						<storyboard event="open">
						</storyboard>
						<storyboard event="activate">
							<animation property="scale" to="1.1" begin="" duration="350" mode="bump"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="scale" to="1" begin="" duration="350" mode="bump"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="scale" to="1" begin="" duration="350" mode="bump"/>
						</storyboard>
					</image>
				</container>
			</itemTemplate>
		</imagegrid>
		<image name="shadowlogosysteme" extra="true">
			<autoFade>false</autoFade>
			<pos>0.052 0.193</pos>
			<origin>0 1</origin>
			<maxSize>0.25 0.12</maxSize>
			<padding>3 3 -3 -3</padding>
			<color>000000</color>
			<path>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
					"${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.svg",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.svg",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".svg")</path>
			<zIndex>80</zIndex>
			<horizontalAlignment>left</horizontalAlignment>
		</image>
		<image name="logosysteme" extra="true">
			<autoFade>false</autoFade>
			<pos>0.052 0.193</pos>
			<origin>0 1</origin>
			<maxSize>0.25 0.12</maxSize>
			<path>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
					"${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.svg",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.svg",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".svg")</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>80</zIndex>
			<horizontalAlignment>left</horizontalAlignment>
		</image>
		<image name="mask" extra="true">
			<origin>0.5 0.5</origin>
			<path>${themePath}/_viewsyst/fanartstar/bgmask.png</path>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<zIndex>4</zIndex>
			<opacity>1</opacity>
		</image>
		<text name="info1" extra="true">
			<fontPath>${themePath}/_viewsyst/fanartstar/fonts/TitilliumWeb-Regular.ttf</fontPath>
			<color>ffffffff</color>
			<pos>0.0525 0.24</pos>
			<size>0.43 0.15</size>
			<size if="${screen.ratio} == '4/3'">0.573 0.06</size>
			<autoScroll if="${screen.ratio} == '4/3'">vertical</autoScroll>
			<alignment>left</alignment>
			<verticalAlignment>top</verticalAlignment>
			<fontSize>0.018</fontSize>
			<glowColor>00000040</glowColor>
			<glowOffset>0.8</glowOffset>
			<glowSize>2</glowSize>
			<lineSpacing>1.2</lineSpacing>
			<visible>true</visible>
			<zIndex>305</zIndex>
		</text>
		<text name="info2" extra="true">
			<visible>false</visible>
		</text>
		<text name="info3" extra="true">
			<visible>false</visible>
		</text>
		<text name="info4" extra="true">
			<visible>false</visible>
		</text>
		<text name="info5" extra="true">
			<visible>false</visible>
		</text>
		<text name="manufacturerName" extra="static">
			<origin>0 1</origin>
			<text>${system.sortedBy}</text>
			<fontPath>${themePath}/_viewsyst/fanartstar/fonts/TitilliumWeb-Light.ttf</fontPath>
			<fontSize>0.040</fontSize>
			<pos>0.0515 0.17</pos>
			<size>0.942 0.28</size>
			<zIndex>100</zIndex>
			<color>D0D0D0FF</color>
			<glowColor>00000080</glowColor>
			<glowSize>1</glowSize>
		</text>
		<text name="fullName" extra="true">
			<text>${system.fullName}      ${system.releaseYearOrNull}</text>
			<alignment>left</alignment>
			<verticalAlignment>top</verticalAlignment>
			<fontPath>${themePath}/_viewsyst/fanartstar/fonts/TitilliumWeb-Light.ttf</fontPath>
			<fontSize>0.024</fontSize>
			<pos>0.0515 0.2</pos>
			<pos verticalScreen="true">0.03 0.10</pos>
			<size>0.94 0.28</size>
			<zIndex>100</zIndex>
			<color>D0D0D0FF</color>
			<glowColor>000000A0</glowColor>
			<glowSize>1</glowSize>
		</text>
		<text name="systemInfoEx" extra="true">
			<text>
