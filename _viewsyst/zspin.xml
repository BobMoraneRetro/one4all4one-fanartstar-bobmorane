			<pos>0 0</pos>
			<origin>0 0</origin>
			<zIndex>12</zIndex>
			<opacity>1</opacity>
			<storyboard>
				<animation property="offsetX" from="-7.9" to="0" duration="800" mode="EaseOutQuint"/>
