			</storyboard>
		</image>
		<image name="bandecouleur" ifSubset="choixbande:couleur" extra="true">
			<path>${zspinbande}</path>
		</image>
		<image name="bandecouleur" ifSubset="choixbande:custorcolor" extra="true">
			<path>${themePath}/_viewsyst/zspin/bandes/custoastro/${system.theme}.png</path>
		</image>
		<image name="bandecouleur" extra="true">
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<zIndex>11</zIndex>
			<opacity>1</opacity>
			<storyboard>
				<animation property="offsetX" from="7.9" to="0" begin="" duration="800" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="couleurdef" ifSubset="choixbande:custorcolor" extra="true">
			<visible>!exists("${themePath}/_viewsyst/zspin/bandes/custoastro/" + stem({system:theme}) + ".png")</visible>
			<path>${zspinbande}</path>
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<zIndex>10</zIndex>
			<opacity>1</opacity>
			<storyboard>
				<animation property="offsetX" from="7.9" to="0" begin="" duration="800" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="zspin_voilefond" extra="true">
			<path>${themePath}/_viewgame/deck/blanc.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<color>0000004D</color>
			<zIndex>3</zIndex>
		</image>
		<image name="vignetteSyst2" extra="true">
			<path>./_viewsyst/zspin/bandes/vignette2z4.png</path>
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<zIndex>3</zIndex>
