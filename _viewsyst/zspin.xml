		</image>
		<image name="vignetteSyst3" extra="true">
			<path>./_viewsyst/zspin/bandes/vignette3z6.png</path>
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<zIndex>200</zIndex>
