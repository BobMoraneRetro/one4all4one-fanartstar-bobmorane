		</image>
		<image name="zspininfo_favoris_icone_ombre" extra="true" if="{system.name} != 'collections' &amp;&amp; {system.name} != 'library' &amp;&amp; {system.name} != 'screenshots'">
			<path>${themePath}/_viewgame/deck/etoile.png</path>
			<pos>0.0209 0.6276</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.0128 0.0205</maxSize>
			<linearSmooth>true</linearSmooth>
			<color>000000D8</color>
			<zIndex>99</zIndex>
			<storyboard>
				<animation property="offsetX" from="-0.52" to="-0.52" duration="260"/>
				<animation property="offsetX" from="-0.52" to="0" begin="260" duration="800" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="deactivate">
