<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${path_game_manuf} : dossier des logos d éditeurs et de constructeurs (définie dans theme.xml ; valeur selon l option « AVANCÉ - Emplacement des logos des éditeurs »)
	${path_syst_logo} : dossier des logos des systèmes (définie dans theme.xml ; valeur selon l option « AVANCÉ - Emplacement des logos des systèmes »)
	${zspinbande} : bandeau de couleur du système (choix « Couleurs changeantes ») (définie dans ce fichier)
	${zspinlogorond} : logo rond du système (roundsilver) (définie dans ce fichier)
	${zspinronddefaut} : logo rond par défaut (système sans logo rond) (définie dans ce fichier)
-->
<theme>
	<variables>
		<zspinbande>${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/or.png</zspinbande>
		<zspinbande if="{system.theme} == 'dreamcast' || {system.theme} == 'model3' || {system.theme} == 'segastv' || {system.theme} == 'vircon32' || {system.theme} == 'wiiu' || {system.theme} == 'windowsbis'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/bleu.png</zspinbande>
		<zspinbande if="{system.theme} == 'cave' || {system.theme} == 'ikemen' || {system.theme} == 'mame' || {system.theme} == 'naomi' || {system.theme} == 'pce-cd'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/rouge.png</zspinbande>
		<zspinbande if="{system.theme} == 'atomiswave' || {system.theme} == 'gaelco' || {system.theme} == 'hbmame' || {system.theme} == 'xbox'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/vert.png</zspinbande>
		<zspinbande if="{system.theme} == 'amiga' || {system.theme} == 'model2' || {system.theme} == 'naomi2'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/orange.png</zspinbande>
		<zspinbande if="{system.theme} == 'daphne' || {system.theme} == 'xbox360' || {system.theme} == 'zordinosaures'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/olive.png</zspinbande>
		<zspinbande if="{system.theme} == 'cps1' || {system.theme} == 'cps2' || {system.theme} == 'cps3'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/or2.png</zspinbande>
		<zspinbande if="{system.theme} == 'namco2x6' || {system.theme} == 'pinballm' || {system.theme} == 'teknoparrot'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/rougefonce.png</zspinbande>
		<zspinbande if="{system.theme} == 'msxcollection' || {system.theme} == 'neogeo64'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/gris.png</zspinbande>
		<zspinbande if="{system.theme} == 'chihiro' || {system.theme} == 'ps2'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/vert2.png</zspinbande>
		<zspinbande if="{system.theme} == 'fbneo' || {system.theme} == 'gb-msu'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/orange2.png</zspinbande>
		<zspinbande if="{system.theme} == 'ps3' || {system.theme} == 'zultraretro'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/violet.png</zspinbande>
		<zspinbande if="{system.theme} == 'wii' || {system.theme} == 'zinc'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/cyan.png</zspinbande>
		<zspinbande if="{system.theme} == 'gc'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/violet2.png</zspinbande>
		<zspinbande if="{system.theme} == 'hikaru'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/bleu2.png</zspinbande>
		<zspinbande if="{system.theme} == 'karaoke'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/rose.png</zspinbande>
		<zspinbande if="{system.theme} == 'retrobat'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/bleufonce.png</zspinbande>
		<zspinbande if="{system.theme} == 'triforce'">${themePath}/_viewsyst/zspin/bandes/couleurs_systemes/violetfonce.png</zspinbande>
		<zspinronddefaut>${path_syst_logo}/roundsilver/_defaut/defaut.png</zspinronddefaut>
		<zspinlogorond>("${path_syst_logo}/roundsilver/" + stem({system:theme}) + ".png")</zspinlogorond>
	</variables>
	<formatVersion>7</formatVersion>
	<view name="system">
		<text name="systemInfo">
			<pos>0 0.75</pos>
			<size>1 0.05</size>
			<backgroundColor>00000000</backgroundColor>
			<color>DDDDDDD8</color>
			<glowColor>000000</glowColor>
			<glowSize>1</glowSize>
			<glowOffset>2</glowOffset>
			<fontPath>${themePath}/_common/fonts/Cabin-Bold.ttf</fontPath>
			<fontSize>0.027</fontSize>
			<zIndex>151</zIndex>
			<storyboard>
				<animation property="opacity" from="0" to="1" duration="350" mode="easeOut"/>
				<animation property="scale" from="0" to="1" duration="350" mode="easeOut"/>
			</storyboard>
		</text>
		<carousel name="systemcarousel">
			<type>horizontal</type>
			<logoAlignment>center</logoAlignment>
			<color>00000000</color>
			<colorEnd>00000000</colorEnd>
			<systemInfoDelay>700</systemInfoDelay>
			<systemInfoCountOnly>false</systemInfoCountOnly>
			<pos>0 1</pos>
			<size>0.4 0.4</size>
			<zIndex>20</zIndex>
			<logoSize>0.1 0.1</logoSize>
			<logoScale>3.3</logoScale>
			<transitionSpeed>650</transitionSpeed>
			<minLogoOpacity>0.6</minLogoOpacity>
			<maxLogoCount>1</maxLogoCount>
			<defaultTransition>instant</defaultTransition>
		</carousel>
		<video name="backgroundvid10" extra="true">
			<path>{random}</path>
			<delay>0.4</delay>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<size>1 1</size>
			<audio>false</audio>
			<zIndex>2</zIndex>
			<effect>none</effect>
		</video>
		<screenshader name="blur2" extra="true">
			<path>:/shaders/blur.glsl</path>
			<size>1 1</size>
			<pos>0 0</pos>
			<blur>12</blur>
			<zIndex>2</zIndex>
			<blurColor>000000</blurColor>
		</screenshader>
		<video name="previewvid1" extra="true">
			<path>{random}</path>
			<delay>0.4</delay>
			<origin>1 0.5</origin>
			<pos>0.997 0.70</pos>
			<maxSize>0.39 0.51</maxSize>
			<zIndex>4</zIndex>
			<effect>fade</effect>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/border_cadre_ombre.glsl</path>
				<cornerRadius>0.012</cornerRadius>
				<borderSize>0.0045</borderSize>
				<borderColor>FFFFFFCD</borderColor>
				<outerShadowSize>0.06</outerShadowSize>
				<outerShadowColor>000000BD</outerShadowColor>
				<shadowOffsetX>-0.016</shadowOffsetX>
				<shadowOffsetY>0.012</shadowOffsetY>
				<shadowBlurX>0.0109</shadowBlurX>
				<shadowBlurY>0.0115</shadowBlurY>
			</shader>
		</video>
		<image name="rondsystdefaut" extra="true">
			<visible>!exists(${zspinlogorond})</visible>
			<maxSize>0.54</maxSize>
			<linearSmooth>true</linearSmooth>
			<path>${zspinronddefaut}</path>
			<pos>0.501 0.42</pos>
			<origin>0.5 0.5</origin>
			<zIndex>115</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<storyboard>
				<animation property="opacity" from="1" to="1" duration="100" mode="Linear"/>
				<animation property="scale" from="0.7" to="1" begin="" autoreverse="false" duration="150" mode="easyOut"/>
			</storyboard>
		</image>
		<image name="pngdefaut" extra="true">
			<visible>!exists(${zspinlogorond})</visible>
			<path>firstfile("${themePath}/_systemmedia/hardware/${region}/" + {system:theme} + ".png", "${themePath}/_systemmedia/hardware/" + {system:theme} + ".png")</path>
			<pos>0.5 0.45</pos>
			<maxSize>0.3 0.45</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>116</zIndex>
			<saturation>0.5</saturation>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<storyboard>
				<animation property="opacity" from="1" to="1" duration="100" mode="Linear"/>
				<animation property="scale" from="0.7" to="1" begin="" autoreverse="false" duration="150" mode="easyOut"/>
			</storyboard>
		</image>
		<image name="marqueedefault" extra="true">
			<path>firstfile("${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
				"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
				"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
				"${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.svg",
				"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.svg",
				"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</path>
		</image>
		<image name="marqueedefault" extra="true">
			<visible>!exists(${zspinlogorond})</visible>
			<linearSmooth>true</linearSmooth>
			<pos>0.5 0.65</pos>
			<maxSize>0.3 0.15</maxSize>
			<scaleOrigin>0.35 0</scaleOrigin>
			<origin>0.5 0.5</origin>
			<zIndex>117</zIndex>
			<scaleOrigin>0.15 -0.5</scaleOrigin>
			<autoFade>false</autoFade>
			<storyboard>
				<animation property="opacity" from="1" to="1" duration="100" mode="Linear"/>
				<animation property="scale" from="0.7" to="1" begin="" autoreverse="false" duration="150" mode="easyOut"/>
			</storyboard>
		</image>
		<image name="roundwheel" extra="true">
			<path>${zspinlogorond}</path>
			<linearSmooth>true</linearSmooth>
			<pos>0.5 0.45</pos>
			<maxSize>0.48 0.6</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>115</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<storyboard>
				<animation property="opacity" from="1" to="1" duration="100" mode="Linear"/>
				<animation property="scale" from="0.7" to="1" begin="" autoreverse="false" duration="150" mode="easyOut"/>
			</storyboard>
		</image>
