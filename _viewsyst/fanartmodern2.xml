<theme>
	<formatVersion>7</formatVersion>
	<!-- Variables specifiques à la vue, en commentaire les variables communes utilisees figurant dans theme.xml -->
	<variables>
		<firstsystfanart>firstfile("${themePath}/_systemmedia/_fanartsysteme/fresh/" + {system:theme} + ".jpg","${themePath}/_systemmedia/_fanartsysteme/custom/" + {system:theme} + ".jpg","${themePath}/_systemmedia/_fanartsysteme/default.png")</firstsystfanart>
		<firstsystemimage>firstfile("${themePath}/_systemmedia/_fanartsysteme/custom/" + {system:theme} + ".jpg","${themePath}/_systemmedia/_fanartsysteme/fresh/" + {system:theme} + ".jpg","${themePath}/_systemmedia/_fanartsysteme/default.png")</firstsystemimage>
		<firstsystemhardware>firstfile("${themePath}/_systemmedia/hardware/" + {system:theme} + ".png","${themePath}/_systemmedia/charsystem/" + {system:theme} + ".png","${themePath}/_systemmedia/_fanartsysteme/default.png")</firstsystemhardware>
		<!-- <bobmediapath>${themePath}</bobmediapath> -->
	</variables>
	<include>${themePath}/_systemmedia/description/${system.theme}.xml</include>
	<view name="system">
			<image name="mask" extra="true">
			<origin>0.5 0.5</origin>
			<path>${themePath}/_viewsyst/fanartstar/bgmask.png</path>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<zIndex>6</zIndex>
			<opacity>1</opacity>
		</image>
		<carousel name="systemcarousel">
			<zIndex>10</zIndex>
			<type>horizontal</type>
			<pos>-0.21 0.22</pos>
			<size>1.45 1</size>
			<logoScale>1</logoScale>
			<logoSize>0.150 0.150</logoSize>
			<color>00000000</color>
			<logoAlignment>bottom</logoAlignment>
			<minLogoOpacity>1</minLogoOpacity>
			<transitionSpeed ifSubset="video4starmodern:videoback">0</transitionSpeed>
			<transitionSpeed ifSubset="video4starmodern:novideo">750</transitionSpeed>
			<logoPos>0.5 0.5</logoPos>
			<imageSource>thumbnail</imageSource>
			<defaultTransition>instant</defaultTransition>
			<logoRotation>0</logoRotation>
			<logoRotationOrigin>0.5 1</logoRotationOrigin>
			<maxLogoCount>8</maxLogoCount>
			<itemTemplate>
				<container>
					<image name="thumb">
						<roundCorners>0.03</roundCorners>
						<pos>0.5 0.505</pos>
						<origin>0.5</origin>
						<minSize>1.15 1.39</minSize>
						<path>${firstsystemimage}</path>
						<zIndex>5</zIndex>
						<shader>
							<path>:/shaders/blur.glsl</path>
							<pos>0 0</pos>
							<blur>10</blur>
							<zIndex>1</zIndex>
							<blurColor>000000</blurColor>
						</shader>
						<storyboard event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard event="activate">
							<animation property="color" to="FFFFFFFF" begin="" duration="150" mode="Linear"/>
							<animation property="scale" to="1.2" begin="" duration="350" mode="easeOut"/>
							<animation property="saturation" to="1" begin="" duration="150" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="color" to="858585ff" begin="" duration="250" mode="Linear"/>
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="saturation" to="0" begin="" duration="150" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="color" to="858585ff" begin="" duration="" mode="Linear"/>
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="saturation" to="0" begin="" duration="150" mode="Linear"/>
						</storyboard>
					</image>
					<image name="vignette">
						<roundCorners>0.03</roundCorners>
						<path>${themePath}/_viewsyst/fanartstar/vignette3.png</path>
						<pos>0.5 0.505</pos>
						<origin>0.5</origin>
						<minSize>1.15 1.39</minSize>
						<zIndex>5</zIndex>
						<storyboard event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard event="activate">
							<animation property="scale" to="1.2" begin="" duration="350" mode="easeOut"/>
							<animation property="color" from="858585ff" to="FFFFFFFF" begin="10" duration="150" mode="Linear" autoReverse="true" repeat="forever"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="opacity" to="1" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="opacity" to="1" begin="" duration="" mode="Linear"/>
						</storyboard>
					</image>
					<image name="cadre">
						<path>${themePath}/_viewsyst/fanartstar/cadre_m2.png</path>
						<origin>0.5</origin>
						<!-- <pos>0.51 0.5</pos> -->
						<!-- <size>1.18 1.42</size> -->
						<!-- modern 2 petit -->
						<pos>0.5 0.5</pos>
						<!-- modern 2 petit -->
						<size>1.16 1.42</size>
						<zIndex>7</zIndex>
						<color>FFFFFFFF</color>
						<linearSmooth>true</linearSmooth>
						<storyboard event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard event="activate">
							<animation property="color" to="FFFFFFFF" begin="" duration="150" mode="Linear"/>
							<animation property="scale" to="1.2" begin="" duration="350" mode="easeOut"/>
							<animation property="color" from="858585ff" to="FFFFFFFF" begin="10" duration="150" mode="Linear" autoReverse="true" repeat="forever"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="opacity" to="1" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="scale" to="1" begin="" duration="350" mode="easeOut"/>
							<animation property="opacity" to="1" begin="" duration="" mode="Linear"/>
						</storyboard>
					</image>
					<image name="shadowlogo" pos="0.51 0.5" origin="0.5" maxSize="1">
						<path>firstfile(
                    "${bobmediapath}/_systemmedia/_logosyst/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${bobmediapath}/_systemmedia/_logosyst/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${bobmediapath}/_systemmedia/_logosyst/clearlogos/" + {system:theme} + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".svg")</path>
						<padding>3 3 -3 -3</padding>
						<color>000000</color>
						<zIndex>6</zIndex>
						<storyboard event="open">
						</storyboard>
						<storyboard event="activate">
							<animation property="scale" to="1.1" begin="" duration="350" mode="bump"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="scale" to="1" begin="" duration="350" mode="bump"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="scale" to="1" begin="" duration="350" mode="bump"/>
						</storyboard>
					</image>
					<image name="logo" extra="true" pos="0.51 0.5" origin="0.5" maxSize="1" linearSmooth="true">
						<path>firstfile(
                    "${bobmediapath}/_systemmedia/_logosyst/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${bobmediapath}/_systemmedia/_logosyst/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${bobmediapath}/_systemmedia/_logosyst/clearlogos/" + {system:theme} + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".svg")</path>
						<zIndex>7</zIndex>
						<storyboard event="open">
						</storyboard>
						<storyboard event="activate">
							<animation property="scale" to="1.1" begin="" duration="350" mode="bump"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="scale" to="1" begin="" duration="350" mode="bump"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="scale" to="1" begin="" duration="350" mode="bump"/>
						</storyboard>
						<text name="nameif">
							<visible>!exists("${bobmediapath}/_systemmedia/_logosyst/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png") &amp;&amp;
			!exists("${bobmediapath}/_systemmedia/_logosyst/clearlogos/region-${region}/" + {system:theme} + "-${region}.png") &amp;&amp;
			!exists("${bobmediapath}/_systemmedia/_logosyst/clearlogos/" + {system:theme} + ".png") &amp;&amp;
			!exists("${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".png") &amp;&amp;
			!exists("${themePath}/../es-theme-carbon//art/logos/" + {system:theme} + ".svg")</visible>
							<text>{system:name}</text>
							<alignment>center</alignment>
							<fontPath>${themePath}/_viewsyst/fanartstar/fonts/TitilliumWeb-Light.ttf</fontPath>
							<fontSize>0.030</fontSize>
							<pos>0.0515 0.2</pos>
							<size>0.94 0.4</size>
							<zIndex>100</zIndex>
							<color>D0D0D0FF</color>
							<glowColor>000000A0</glowColor>
							<glowSize>1</glowSize>
						</text>
					</image>
				</container>
			</itemTemplate>
		</carousel>
<!-- ### Screens et gameplay video angle de 30 degrés ################################################################################################# -->
		<image name="randomgamecadre" ifSubset="video4starmodern:videoangled"  extra="true">
			<path>${themePath}/_viewgame/fanartstar/169alt1.png</path>
			<!--<pos>0.995 0.35</pos> -->
			<!-- <size>0.38 0.488</size> -->
			<pos>1 0.35</pos>
			<size>0.39 0.505</size>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>89</zIndex>
			<autoFade>false</autoFade>
			<shader>
				<path>${themePath}/_common/shaders/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
		</image>
		<image name="randomgamefond" ifSubset="video4starmodern:videoangled"  extra="true">
			<path>${themePath}/_viewgame/fanartstar/fiber.png</path>
			<pos>0.995 0.35</pos>
			<size>0.38 0.472</size>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>55</zIndex>
			<autoFade>false</autoFade>
			<shader>
				<path>${themePath}/_common/shaders/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
		</image>
		<video name="randomvideo" ifSubset="video4starmodern:videoangled"  extra="true">
			<path>{random}</path>
			<delay>0.3</delay>
			<pos>0.995 0.35</pos>
			<size>0.38 0.47</size>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>80</zIndex>
			<shader>
				<path>${themePath}/_common/shaders/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
		</video>
		<control name="randomgamecadre,randomgamefond,randomvideo" ifSubset="video4starmodern:videoangled" >
			<offsetX>0.038</offsetX>
		</control>
		<!-- ################################### Metadata et autres infos textuelles #############################################################################		 -->
		<image name="shadowlogosysteme" extra="true">
			<autoFade>false</autoFade>
			<pos>0.052 0.193</pos>
			<origin>0 1</origin>
			<maxSize>0.25 0.12</maxSize>
			<padding>3 3 -3 -3</padding>
			<color>000000</color>
			<path>firstfile(
                    "${bobmediapath}/_systemmedia/_logosyst/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${bobmediapath}/_systemmedia/_logosyst/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${bobmediapath}/_systemmedia/_logosyst/clearlogos/" + {system:theme} + ".png")</path>
			<zIndex>80</zIndex>
			<horizontalAlignment>left</horizontalAlignment>
		</image>
		<image name="logosysteme" extra="true">
			<autoFade>false</autoFade>
			<pos>0.052 0.193</pos>
			<origin>0 1</origin>
			<maxSize>0.25 0.12</maxSize>
			<path>firstfile(
                    "${bobmediapath}/_systemmedia/_logosyst/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${bobmediapath}/_systemmedia/_logosyst/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${bobmediapath}/_systemmedia/_logosyst/clearlogos/" + {system:theme} + ".png")</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>80</zIndex>
			<horizontalAlignment>left</horizontalAlignment>
		</image>
		<!-- Description du système -->
		<text name="info1" extra="true">
			<fontPath>${themePath}/_viewsyst/fanartstar/fonts/TitilliumWeb-Regular.ttf</fontPath>
			<color>ffffffff</color>
			<pos>0.0525 0.24</pos>
			<size>0.43 0.15</size>
			<alignment>left</alignment>
			<verticalAlignment>top</verticalAlignment>
			<fontSize>0.018</fontSize>
			<singleLineScroll>false</singleLineScroll>
			<glowColor>00000040</glowColor>
			<glowOffset>0.8</glowOffset>
			<glowSize>2</glowSize>
			<lineSpacing>1.2</lineSpacing>
			<visible>true</visible>
			<zIndex>305</zIndex>
		</text>
		<!-- Nom du système -->
		<text name="info2" extra="true">
			<visible>false</visible>
		</text>
		<!-- Année de construction -->
		<text name="info3" extra="true">
			<visible>false</visible>
		</text>
		<!-- Constructeur -->
		<text name="info4" extra="true">
			<visible>false</visible>
		</text>
		<text name="info5" extra="true">
			<visible>false</visible>
		</text>
		<text name="manufacturerName" extra="static">
			<origin>0 1</origin>
			<text>${system.sortedBy}</text>
			<fontPath>${themePath}/_viewsyst/fanartstar/fonts/TitilliumWeb-Light.ttf</fontPath>
			<fontSize>0.040</fontSize>
			<pos>0.0515 0.17</pos>
			<size>0.942 0.28</size>
			<zIndex>100</zIndex>
			<!-- <color>C0C0C0</color> -->
			<color>D0D0D0FF</color>
			<glowColor>00000080</glowColor>
			<glowSize>1</glowSize>
		</text>
		<text name="fullName" extra="true">
