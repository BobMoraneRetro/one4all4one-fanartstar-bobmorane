<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${intfanartcustom} : Fanart du système (dossier custom) (définie dans theme.xml)
	${intfanartfresh} : Fanart du système (dossier fresh) (définie dans theme.xml)
-->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="fanartflix" extra="true">
			<autoFade>false</autoFade>
			<path ifSubset="imagefondcops1:fanartfreshone">${intfanartfresh}</path>
			<path ifSubset="imagefondcops1:fanartcustom">${intfanartcustom}</path>
			<origin>0 0</origin>
			<pos>0 0</pos>
			<pos ifSubset="systemview:fanartstarsyst">0.55 0</pos>
			<size>1.03 1.02</size>
			<size ifSubset="systemview:fanartstarsyst">0 0.9</size>
			<origin ifSubset="systemview:fanartstarsyst">0.5 0</origin>
			<pos ifSubset="systemview:fanartmodern|fanartmodern2" if="${screen.ratio} == '4/3'">0.5 0</pos>
			<size ifSubset="systemview:fanartmodern|fanartmodern2" if="${screen.ratio} == '4/3'">0 1.02</size>
			<origin ifSubset="systemview:fanartmodern|fanartmodern2" if="${screen.ratio} == '4/3'">0.5 0</origin>
			<zIndex>0</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
	</view>
</theme>
