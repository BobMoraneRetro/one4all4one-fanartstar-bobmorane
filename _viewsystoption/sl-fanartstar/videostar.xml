<!--
	Variables utilisées dans ce fichier :
	${intbezelsyst} : Bezel du système affiché (définie dans theme.xml)
-->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="blablacksyt" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<path>${themePath}/_common/images/black.png</path>
			<size>1 1</size>
			<zIndex>3</zIndex>
			<opacity>1</opacity>
		</image>
		<video name="backgroundvideo" extra="true">
			<default>${themePath}/_systemmedia/defaut/scotty.mp4</default>
			<path>{random}</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<maxSize>1 1</maxSize>
			<effect>none</effect>
			<zIndex>4</zIndex>
			<opacity>1</opacity>
			<delay>0</delay>
		</video>
		<image name="scanlines" extra="true">
			<tile>true</tile>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<path>${themePath}/_common/shaders/scanlines01.png</path>
			<maxSize>1 1</maxSize>
			<zIndex>5</zIndex>
			<opacity>1</opacity>
		</image>
		<image name="bezel" extra="true">
			<origin>0.5 0.5</origin>
			<path>${intbezelsyst}</path>
			<maxSize>1 1</maxSize>
			<pos>0.5 0.5</pos>
			<linearSmooth>true</linearSmooth>
			<zIndex>5</zIndex>
			<opacity>1</opacity>
		</image>
	</view>
</theme>
