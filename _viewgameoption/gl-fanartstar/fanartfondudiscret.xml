<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${intfanartfresh} : Fanart du système (dossier fresh) (définie dans theme.xml)
	${media_fanart_exists} : vrai si le média « fanart » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	Libellés traduits (_common/_langs/<langue>.xml) : ${presetdeck}, ${presetshowbig}, ${presetshowsmall}, ${presetspotlight}, ${presetsquare}, ${presetstar169}, ${presetstar43}, ${presetstarbox}, ${presetstarboxloop}, ${presettraviolta_alt}
-->
<theme>
	<formatVersion>7</formatVersion>
	<customView name="presetstarbox" displayName="${presetstarbox}" inherits="gamecarousel">
		<image name="fanartsoustransition" extra="true">
			<visible>${media_fanart_exists}</visible>
			<path>${intfanartfresh}</path>
			<pos>0 0</pos>
			<pos ifSubset="perfmachine:perflow">0.5 0.5</pos>
			<size>1 1</size>
			<size ifSubset="perfmachine:perflow">0 1</size>
			<origin>0 0</origin>
			<origin ifSubset="perfmachine:perflow">0.5 0.5</origin>
			<color>8C8C8CFF</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>1.9</zIndex>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/fanart_bord_repete.glsl</path>
				<hauteur>0.8</hauteur>
				<decalageHaut>0</decalageHaut>
				<bande>0.12</bande>
				<flou>32</flou>
				<assombrir>0.3</assombrir>
				<distanceFond>350</distanceFond>
				<saturationFond>0.8</saturationFond>
				<transition>70</transition>
				<vignettage>0.25</vignettage>
			</shader>
		</image>
		<image name="fanart" extra="true">
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOutQuint"/>
			</storyboard>
		</image>
		<image name="defautfanart" extra="true">
			<storyboard event="open">
				<animation property="opacity" from="0" to="0.5" duration="300" mode="easeOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0.5" duration="300" mode="easeOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0.5" duration="300" mode="easeOutQuint"/>
			</storyboard>
		</image>
	</customView>
