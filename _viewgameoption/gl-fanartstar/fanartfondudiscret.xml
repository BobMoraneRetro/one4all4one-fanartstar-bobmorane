	<customView name="presettraviolta_alt" displayName="${presettraviolta_alt}" inherits="gamecarousel">
		<image name="fanartpreset_soustransition" extra="true">
			<visible>{game:rom} != '..'</visible>
			<shared>false</shared>
			<path>${intfanartfresh}</path>
			<autoFade>false</autoFade>
			<linearSmooth>true</linearSmooth>
			<pos>0.5 0.5</pos>
			<pos if="{system.theme} == 'windows'
			|| {system.theme} == 'switch'">0.5 0.35</pos>
			<origin>0.5 0.5</origin>
			<maxSize>2 1</maxSize>
			<maxSize if="{system.theme} == 'windows'
			|| {system.theme} == 'switch'">1 1</maxSize>
			<shader ifSubset="perfmachine:perfnormal" if="{system.theme} == 'windows'
			|| {system.theme} == 'switch'">
				<path>${themePath}/_common/shaders/border_cadre.glsl</path>
				<cornerRadius>1</cornerRadius>
				<borderSize>0.005</borderSize>
				<borderColor>000000</borderColor>
				<innerShadowSize>0.02</innerShadowSize>
				<innerShadowColor>000000</innerShadowColor>
				<outerShadowSize>0</outerShadowSize>
				<outerShadowColor>000000</outerShadowColor>
			</shader>
			<color>8C8C8CFF</color>
			<zIndex>1.9</zIndex>
		</image>
		<image name="fanartpreset" extra="true">
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOutQuint"/>
			</storyboard>
		</image>
	</customView>
	<customView name="presetspotlight" displayName="${presetspotlight}" inherits="grid">
		<image name="spot_fond_soustransition" extra="true">
			<visible>{game:rom} != '..'</visible>
			<path>${intfanartfresh}</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<minSize>1.04 1.04</minSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>0.9</zIndex>
			<color>8C8C8CFF</color>
		</image>
		<image name="spot_fond" extra="true">
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOutQuint"/>
				<animation property="scale" from="1" to="1.10" begin="300" duration="14000" mode="easeInOut"/>
				<animation property="x" from="0.5" to="0.465" begin="300" duration="14000" mode="easeInOut"/>
				<animation property="y" from="0.5" to="0.485" begin="300" duration="14000" mode="easeInOut"/>
				<animation property="scale" from="1.10" to="1" begin="14300" duration="14000" mode="easeInOut"/>
				<animation property="x" from="0.465" to="0.5" begin="14300" duration="14000" mode="easeInOut"/>
				<animation property="y" from="0.485" to="0.5" begin="14300" duration="14000" mode="easeInOut"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOutQuint"/>
				<animation property="scale" from="1" to="1.10" begin="300" duration="14000" mode="easeInOut"/>
				<animation property="x" from="0.5" to="0.465" begin="300" duration="14000" mode="easeInOut"/>
				<animation property="y" from="0.5" to="0.485" begin="300" duration="14000" mode="easeInOut"/>
				<animation property="scale" from="1.10" to="1" begin="14300" duration="14000" mode="easeInOut"/>
				<animation property="x" from="0.465" to="0.5" begin="14300" duration="14000" mode="easeInOut"/>
				<animation property="y" from="0.485" to="0.5" begin="14300" duration="14000" mode="easeInOut"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOutQuint"/>
				<animation property="scale" from="1" to="1.10" begin="300" duration="14000" mode="easeInOut"/>
				<animation property="x" from="0.5" to="0.535" begin="300" duration="14000" mode="easeInOut"/>
				<animation property="y" from="0.5" to="0.485" begin="300" duration="14000" mode="easeInOut"/>
				<animation property="scale" from="1.10" to="1" begin="14300" duration="14000" mode="easeInOut"/>
				<animation property="x" from="0.535" to="0.5" begin="14300" duration="14000" mode="easeInOut"/>
				<animation property="y" from="0.485" to="0.5" begin="14300" duration="14000" mode="easeInOut"/>
			</storyboard>
		</image>
	</customView>
