	<customView name="presetstarbox" displayName="${presetstarbox}" inherits="gamecarousel">
		<image name="fanart" extra="true">
			<scaleOrigin>0.5 0.5</scaleOrigin>
			<storyboard event="open">
				<animation property="opacity" from="0.4" to="1" duration="450" mode="easeOut"/>
				<animation property="scale" from="1.08" to="1" duration="1800" mode="easeOut"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0.4" to="1" duration="450" mode="easeOut"/>
