<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${media_video_exists} : vrai si le média « video » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${salon_ecran2} : vue Salon : true = 2e écran (2 consoles reliées, ex. gbc2players), même vidéo, capture, couleur et calque que le 1er ; réglable par <système>.xml (définie dans _gamemedia/_salon/_documentation/exemple_complet.xml, _gamemedia/_salon/gbc2players.xml, _viewgame/presetsalon.xml)
	${salon_video_etiree} : vue Salon : true = vidéo étirée à la taille de l écran de la TV (size), false = proportions gardées (maxSize) ; réglable par <système>.xml (définie dans _gamemedia/_salon/ (45 fichiers))
	Libellés traduits (_common/_langs/<langue>.xml) : ${presetdeck}, ${presetsalon}, ${presetshowbig}, ${presetshowsmall}, ${presetspeedbull}, ${presetspotlight}, ${presetsquare}, ${presetstarbox}, ${presetstarboxloop}
-->
<theme>
	<formatVersion>7</formatVersion>
	<customView name="presetstarbox" displayName="${presetstarbox}" inherits="gamecarousel">
		<image name="screenshotgames" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<visible>!(${media_video_exists})</visible>
		</image>
		<image name="screenshotgames" ifSubset="starvideo:starvideoang" extra="true">
			<visible>!(${media_video_exists})</visible>
		</image>
		<video name="videogameplay" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="open">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
		</video>
		<video name="videogameplay" ifSubset="starvideo:starvideoang" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="open">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
		</video>
	</customView>
	<customView name="presetstarboxloop" displayName="${presetstarboxloop}" inherits="grid">
		<image name="screenshotgames" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<visible>!(${media_video_exists})</visible>
		</image>
		<image name="screenshotgames" ifSubset="starvideo:starvideoang" extra="true">
			<visible>!(${media_video_exists})</visible>
		</image>
		<video name="videogameplay" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="open">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
		</video>
		<video name="videogameplay" ifSubset="starvideo:starvideoang" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
			<storyboard event="open">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
		</video>
	</customView>
	<customView name="presetdeck" displayName="${presetdeck}" inherits="grid">
		<video name="deck_video" extra="true">
			<delay>0</delay>
			<effect>none</effect>
			<storyboard event="activate">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivate">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
	</customView>
	<customView name="presetspotlight" displayName="${presetspotlight}" inherits="grid">
		<video name="spot_video" extra="true">
			<delay>0</delay>
		</video>
		<video name="spot_videogauche" extra="true">
			<delay>0</delay>
			<effect>none</effect>
		</video>
	</customView>
	<customView name="presetsquare" displayName="${presetsquare}" inherits="grid">
		<video name="grid_video" extra="true">
			<delay>0</delay>
			<storyboard event="activate">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivate">
				<animation property="opacity" to="0" begin="200" duration="50" mode="easeIn"/>
			</storyboard>
		</video>
		<image name="grid_capture" extra="true">
			<visible>!(${media_video_exists})</visible>
		</image>
	</customView>
	<customView name="presetshowbig" displayName="${presetshowbig}" inherits="gamecarousel">
		<video name="previewvidpreset" extra="true">
			<delay>0</delay>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" begin="200" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
