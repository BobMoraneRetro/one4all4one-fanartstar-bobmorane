<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${media_marquee} : logo du jeu (marquee) (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_marquee_missing} : vrai si le média « marquee » du jeu manque (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${selopacite} : opacité des jeux non sélectionnés dans les grilles (1, 0.7 ou 0.45) (définie dans ce fichier ; valeur selon l option « JEUX - Mise en valeur du jeu sélectionné »)
	${titrejeu} : valeur : {game:name} (définie dans _viewgameoption/gl-common/options_nom.xml ; valeur selon l option « JEUX - Nom du jeu »)
-->
<theme>
	<formatVersion>7</formatVersion>
	<variables>
		<selopacite ifSubset="selectionvaleur:legere">0.7</selopacite>
		<selopacite ifSubset="selectionvaleur:marquee">0.45</selopacite>
		<selopacite ifSubset="selectionvaleur:aucune">1</selopacite>
	</variables>
	<view name="gamecarousel">
		<gamecarousel name="gamecarousel">
			<itemTemplate>
				<container>
					<image name="logo">
						<opacity>${selopacite}</opacity>
						<path>${media_marquee}</path>
						<pos>0.5 0.5</pos>
						<origin>0.5 0.5</origin>
						<maxSize>1 1</maxSize>
						<linearSmooth>true</linearSmooth>
						<storyboard event="activate">
							<animation property="opacity" to="1" duration="200" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="opacity" to="${selopacite}" duration="200" mode="easeOut"/>
						</storyboard>
					</image>
					<text name="nomjeu">
						<opacity>${selopacite}</opacity>
						<visible>${media_marquee_missing}</visible>
						<storyboard event="activate">
							<animation property="opacity" to="1" duration="200" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="opacity" to="${selopacite}" duration="200" mode="easeOut"/>
						</storyboard>
						<text>${titrejeu}</text>
						<pos>0.5 0.5</pos>
						<origin>0.5 0.5</origin>
						<size>1 1</size>
						<fontPath>${themePath}/_common/fonts/Cabin-Bold.ttf</fontPath>
						<fontSize>0.035</fontSize>
						<color>FFFFFF</color>
						<alignment>center</alignment>
						<glowColor>00000099</glowColor>
						<glowSize>2</glowSize>
					</text>
				</container>
			</itemTemplate>
		</gamecarousel>
	</view>
</theme>
