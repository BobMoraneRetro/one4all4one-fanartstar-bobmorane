<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${fanartsource} : champ du gamelist où chercher la fanart (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart »)
	${firstsystemhardware} : Vue système classique, option Hardware : console, sinon personnage du système (définie dans theme.xml)
	${intfanartfresh} : Fanart du système (dossier fresh) (définie dans theme.xml)
	${intlogoclearpng} : Logo clair du système (définie dans theme.xml)
	${media_box2d} : boîte 2D du jeu (gamelist ou média perso selon l option) (définie dans _viewgameoption/gl-common/gamemedia/3dinboxart.xml, _viewgameoption/gl-common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_box3d} : boîte 3D du jeu (gamelist ou média perso selon l option) (définie dans _viewgameoption/gl-common/gamemedia/3dinboxart.xml, _viewgameoption/gl-common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart} : fanart du jeu (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart_exists} : vrai si le média « fanart » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart_missing} : vrai si le média « fanart » du jeu manque (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_wheel} : logo « wheel » du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${noteicone} : icône de notation (étoile, cœur, manette...) (définie dans _viewgameoption/gl-common/options_note.xml ; valeur selon l option « JEUX - Icône de notation »)
	${titrejeu} : valeur : {game:name} (définie dans _viewgameoption/gl-common/options_nom.xml ; valeur selon l option « JEUX - Nom du jeu »)
	Libellés traduits (_common/_langs/<langue>.xml) : ${nodates}, ${noplaycount}, ${noplayerdata}, ${noratings}, ${notesur100}, ${playcount}, ${playcountone}, ${player}, ${playerss}, ${presetstar43}, ${presgame1}, ${presgame2}, ${presgame3}, ${presgame4}, ${retourdossier}
-->
<theme>
	<formatVersion>7</formatVersion>
	<customView name="presetstar43" displayName="${presetstar43}" inherits="grid">
		<control name="fanart_extra, defautfanartextra">
			<visible>false</visible>
		</control>
		<video name="md_video">
			<visible>false</visible>
		</video>
		<image name="grid_capture" extra="true">
			<visible>false</visible>
		</image>
		<video name="grid_video" extra="true">
			<visible>false</visible>
		</video>
		<imagegrid name="gamegrid">
			<pos>-0.0302 0.72</pos>
			<pos ifHelpPrompts="true">-0.0302 0.69</pos>
			<size>1.06 0.35</size>
			<autoLayout>7 1</autoLayout>
			<animateSelection>false</animateSelection>
			<zIndex>50</zIndex>
			<autoLayoutSelectedZoom>1.5</autoLayoutSelectedZoom>
			<imageSource>${fanartsource}</imageSource>
			<padding>0.03 0.05 0.03 0.12</padding>
			<margin>0 0.03</margin>
			<showVideoAtDelay>100</showVideoAtDelay>
			<centerSelection>true</centerSelection>
			<scrollLoop>true</scrollLoop>
			<scrollDirection>horizontal</scrollDirection>
		</imagegrid>
		<gridtile name="default">
			<size>0.5 0.35</size>
			<padding>2 2</padding>
			<backgroundCenterColor>FFFFFF00</backgroundCenterColor>
			<backgroundEdgeColor>909090</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:skyblue">0099ff</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:navy">000080</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:candy">FF0040</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:green">00ff33</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:greenalt">2baf2b</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:grey">333333</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:lightgrey">D3D3D3</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:orange">ff6600</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:pink">ff0099</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:purplealt">554488</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:violet">330099</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:redalt">7F1425</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:red">FF0000</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:purple">c377e0</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:yellowalt">909090</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:yellow">ffff00</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:default">ffffff</backgroundEdgeColor>
			<backgroundCornerSize>0 0</backgroundCornerSize>
			<selectionMode>image</selectionMode>
			<imageSizeMode>minSize</imageSizeMode>
			<imageColor>858585ff</imageColor>
			<imageColor ifSubset="selectionvaleur:legere">858585B3</imageColor>
			<imageColor ifSubset="selectionvaleur:marquee">85858573</imageColor>
			<imageColor ifSubset="selectionvaleur:aucune">858585ff</imageColor>
		</gridtile>
		<gridtile name="selected">
			<padding>6 6</padding>
			<backgroundEdgeColor ifSubset="gridcolor:skyblue">0099ff</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:navy">000080</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:candy">FF0040</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:green">00ff33</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:greenalt">2baf2b</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:grey">333333</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:lightgrey">D3D3D3</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:orange">ff6600</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:pink">ff0099</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:purplealt">554488</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:violet">330099</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:redalt">7F1425</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:red">FF0000</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:purple">c377e0</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:yellowalt">909090</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:yellow">ffff00</backgroundEdgeColor>
			<backgroundEdgeColor ifSubset="gridcolor:default">ffffff</backgroundEdgeColor>
			<backgroundCornerSize>0</backgroundCornerSize>
			<imageColor>FFFFFFFF</imageColor>
		</gridtile>
		<image name="gridtile.marquee">
			<color>A5A5A5ff</color>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<size>0.7 0.5</size>
		</image>
		<image name="gridtile.marquee:selected">
			<pos>0.5 0.5</pos>
			<color>FFFFFFFF</color>
			<size>0.75 0.75</size>
		</image>
		<image name="gridtile.favorite:selected">
			<color>ffff00</color>
		</image>
		<image name="gridtile.marquee:videoplaying">
			<color>FFFFFFA0</color>
			<size>0 0</size>
		</image>
		<image name="gridtile.favorite">
			<pos>0.9 0.10</pos>
			<maxSize>0.2 0.2</maxSize>
			<origin>0.5 0.5</origin>
			<horizontalAlignment>right</horizontalAlignment>
		</image>
		<ninepatch name="gridtile.background:selected">
			<cornerSize>0 0</cornerSize>
			<padding>-3 -3</padding>
			<color>ffffff</color>
			<animateColor>141414</animateColor>
			<animateColorTime>850</animateColorTime>
			<zIndex>500</zIndex>
		</ninepatch>
		<image name="defautfanart" extra="true">
			<visible>(${media_fanart_missing}) &amp;&amp; {game:rom} != '..'</visible>
			<path>${intfanartfresh}</path>
			<autoFade>false</autoFade>
			<pos>0.5 0.5</pos>
			<size>0 1</size>
			<opacity>0.5</opacity>
			<saturation>0</saturation>
			<origin>0.5 0.5</origin>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="defautboxart" extra="true">
			<visible>(${media_fanart_missing}) &amp;&amp; {game:rom} != '..'</visible>
			<path ifSubset="boxorthumb:boxart">${media_box3d}</path>
			<path ifSubset="boxorthumb:thumb">${media_box2d}</path>
			<autoFade>false</autoFade>
			<pos>0.96 0.7</pos>
			<maxSize>0.4 0.6</maxSize>
			<origin>1 1</origin>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="fanart" extra="true">
			<visible>${media_fanart_exists}</visible>
			<path>${media_fanart}</path>
			<autoFade>false</autoFade>
			<pos>0.5 0.5</pos>
			<size>0 1</size>
			<origin>0.5 0.5</origin>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="overlaybase" extra="true">
			<path>${themePath}/_viewgame/fanartstar/OverlayDiamonds.png</path>
			<size>1 1</size>
			<flipX>true</flipX>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>3</zIndex>
		</image>
		<image name="fadebottom" extra="true">
			<path>${themePath}/_viewgame/fanartstar/overlaydown.png</path>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>3</zIndex>
		</image>
		<image name="logosytemgamelist" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.94 0.04</pos>
			<path>${intlogoclearpng}</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<zIndex>80</zIndex>
		</image>
		<image name="md_wheel">
			<visible>false</visible>
		</image>
		<image name="logowheel" extra="true">
			<visible>{game:rom} != '..'</visible>
			<path>${media_wheel}</path>
			<pos>0.05 0.165</pos>
			<origin>0 0.5</origin>
			<maxSize>0.25 0.23</maxSize>
			<zIndex>10</zIndex>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
		</image>
		<text name="gamename" extra="true">
			<visible>{game:rom} != '..'</visible>
			<text>${titrejeu}</text>
			<opacity>0.7</opacity>
			<pos>0.252 0.63</pos>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<fontSize>0.025</fontSize>
			<color>ffffffff</color>
			<origin>0.5 0.5</origin>
			<size>0.4 0.02</size>
			<alignment>left</alignment>
			<glowColor>00000016</glowColor>
			<glowSize>3</glowSize>
			<zIndex>305</zIndex>
		</text>
		<image name="retourfond" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${themePath}/_viewgame/commun/retour/retour_fond.jpg</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 1</minSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="retourlogosyst" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${intlogoclearpng}</path>
			<pos>0.05 0.16</pos>
			<origin>0 0.5</origin>
			<maxSize>0.25 0.15</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>10</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOut"/>
			</storyboard>
		</image>
		<image name="retourconsole" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${firstsystemhardware}</path>
			<pos>0.72 0.36</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.36 0.42</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>10</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
				<animation property="x" from="0.75" to="0.72" duration="500" mode="easeOut"/>
			</storyboard>
		</image>
		<image name="retourfleche" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${themePath}/_viewgame/commun/retour/retour.png</path>
			<pos>0.052 0.63</pos>
			<origin>0 0.5</origin>
			<maxSize>0.012 0.022</maxSize>
			<color>FFFFFFE6</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>305</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOut"/>
			</storyboard>
		</image>
		<text name="retourtexte" extra="true">
			<visible>{game:rom} == '..'</visible>
			<text>${retourdossier}</text>
			<opacity>0.9</opacity>
			<pos>0.267 0.63</pos>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<fontSize>0.025</fontSize>
			<color>ffffffff</color>
			<origin>0.5 0.5</origin>
			<size>0.4 0.02</size>
			<alignment>left</alignment>
			<glowColor>00000016</glowColor>
			<glowSize>3</glowSize>
			<zIndex>305</zIndex>
		</text>
		<text name="developer" extra="true">
			<visible>{game:rom} != '..'</visible>
			<color>EFEFFF</color>
			<pos>0.0525 0.630</pos>
			<size>0.7 0.05</size>
			<text>${presgame1} {game:genre} ${presgame2} {game:developer} ${presgame3} {game:system} ${presgame4} {game:lang}</text>
			<alignment>left</alignment>
			<fontSize>0.015</fontSize>
		</text>
		<text name="md_description">
			<visible>false</visible>
		</text>
		<text name="desc_jeu" extra="true">
			<visible>{game:rom} != '..'</visible>
			<text>{game:desc}</text>
			<color>EFEFFF</color>
			<pos>0.0525 0.666</pos>
			<size>0.3 0.035</size>
			<alignment>left</alignment>
			<fontSize>0.015</fontSize>
			<lineSpacing>1</lineSpacing>
			<autoScroll>vertical</autoScroll>
			<verticalAlignment>top</verticalAlignment>
			<zIndex>305</zIndex>
		</text>
		<image name="playblack" extra="true">
			<tile>false</tile>
			<origin>0.5 0.5</origin>
			<pos>0.085 0.72</pos>
			<maxSize>0.085 0.085</maxSize>
			<zIndex>305</zIndex>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<path>${themePath}/_viewgame/fanartstar/Bvierge.png</path>
		</image>
		<text name="binds_playcount" extra="true">
			<visible>({game:playcount} &gt; 1 ? 1 : 0) &amp;&amp; {game:rom} != '..'</visible>
			<color>FFFFFF</color>
			<text>{game:playcount} ${playcount}</text>
			<origin>0.5 0.5</origin>
			<pos>0.085 0.7185</pos>
			<size>0.08 0.035</size>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>305</zIndex>
		</text>
		<text name="binds_playcount_one" extra="true">
			<visible>({game:playcount} == 1 ? 1 : 0) &amp;&amp; {game:rom} != '..'</visible>
			<color>FFFFFF</color>
			<text>{game:playcount} ${playcountone}</text>
			<origin>0.5 0.5</origin>
			<pos>0.085 0.7185</pos>
			<size>0.08 0.035</size>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>305</zIndex>
		</text>
		<text name="binds_noplaycount" extra="true">
			<visible>({game:playcount} &gt; 0 ? 0 : 1) &amp;&amp; {game:rom} != '..'</visible>
			<color>FFFFFF</color>
			<text>${noplaycount}</text>
			<origin>0.5 0.5</origin>
			<pos>0.085 0.7185</pos>
			<size>0.08 0.035</size>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>305</zIndex>
		</text>
		<image name="dateblack" extra="true">
			<tile>false</tile>
			<origin>0.5 0.5</origin>
			<pos>0.16 0.72</pos>
			<maxSize>0.085 0.085</maxSize>
			<zIndex>300</zIndex>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<path>${themePath}/_viewgame/fanartstar/Bvierge.png</path>
		</image>
		<text name="binds_releasedate" extra="true">
			<visible>({game:releaseyear} &gt; 0 ? 1 : 0) &amp;&amp; {game:rom} != '..'</visible>
			<color>FFFFFF</color>
			<text>{game:releaseyear}</text>
			<origin>0.5 0.5</origin>
			<pos>0.16 0.7185</pos>
			<size>0.05 0.035</size>
			<forceUppercase>0</forceUppercase>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>305</zIndex>
		</text>
		<text name="binds_noreleasedate" extra="true">
			<visible>({game:releaseyear} &gt; 0 ? 0 : 1) &amp;&amp; {game:rom} != '..'</visible>
			<color>FFFFFF</color>
			<text>${nodates}</text>
			<origin>0.5 0.5</origin>
			<pos>0.16 0.7185</pos>
			<size>0.1 0.035</size>
			<forceUppercase>0</forceUppercase>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>305</zIndex>
		</text>
		<image name="playerblack" extra="true">
			<tile>false</tile>
			<origin>0.5 0.5</origin>
			<pos>0.235 0.72</pos>
			<maxSize>0.085 0.085</maxSize>
			<zIndex>205</zIndex>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<path>${themePath}/_viewgame/fanartstar/Bvierge.png</path>
		</image>
		<text name="binds_players" extra="true">
			<visible>(!empty({game:players}) &amp;&amp; {game:playerCount} &gt; 1) &amp;&amp; {game:rom} != '..'</visible>
			<text>{game:players} ${playerss}</text>
			<color>FFFFFF</color>
			<origin>0.5 0.5</origin>
			<pos>0.235 0.7185</pos>
			<size>0.075 0.035</size>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>305</zIndex>
		</text>
		<text name="binds_player_one" extra="true">
			<visible>(!empty({game:players}) &amp;&amp; {game:playerCount} == 1) &amp;&amp; {game:rom} != '..'</visible>
			<text>{game:players} ${player}</text>
			<color>FFFFFF</color>
			<origin>0.5 0.5</origin>
			<pos>0.235 0.7185</pos>
			<size>0.075 0.035</size>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>305</zIndex>
		</text>
		<text name="binds_noplayers" extra="true">
			<visible>(empty({game:players})) &amp;&amp; {game:rom} != '..'</visible>
			<text>${noplayerdata}</text>
			<color>FFFFFF</color>
			<origin>0.5 0.5</origin>
			<pos>0.235 0.7185</pos>
			<size>0.075 0.035</size>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>305</zIndex>
		</text>
		<image name="notation" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.31 0.72</pos>
			<maxSize>0.085 0.085</maxSize>
			<zIndex>305</zIndex>
