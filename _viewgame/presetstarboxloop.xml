<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${extgamesyst} : Logo clair du système du jeu (collections : système d'origine du jeu) (définie dans theme.xml)
	${extmanufacturer} : Logo de l'éditeur du jeu (définie dans theme.xml)
	${firstsystemhardware} : Vue système classique, option Hardware : console, sinon personnage du système (définie dans theme.xml)
	${intfanartfresh} : Fanart du système (dossier fresh) (définie dans theme.xml)
	${media_fanart} : fanart du jeu (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart_exists} : vrai si le média « fanart » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart_missing} : vrai si le média « fanart » du jeu manque (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_image} : capture du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_marquee} : logo du jeu (marquee) (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_video} : vidéo du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${noteicone} : icône de notation (étoile, cœur, manette...) (définie dans _viewgameoption/gl-common/options_note.xml ; valeur selon l option « JEUX - Icône de notation »)
	${path_syst_logo} : dossier des logos des systèmes (définie dans theme.xml ; valeur selon l option « AVANCÉ - Emplacement des logos des systèmes »)
	${titrejeulangue} : valeur : {game:name} ( {game:lang} ) (définie dans _viewgameoption/gl-common/options_nom.xml ; valeur selon l option « JEUX - Nom du jeu »)
	Libellés traduits (_common/_langs/<langue>.xml) : ${favuniquement}, ${longselect}, ${nodates}, ${nogametime}, ${noplayerdata}, ${noratings}, ${notesur100}, ${playcount}, ${playcountone}, ${player}, ${playerss}, ${presetstarboxloop}, ${retourdossier}, ${tslesjeux}
-->
<theme>
	<formatVersion>7</formatVersion>
	<customView name="presetstarboxloop" displayName="${presetstarboxloop}" inherits="grid">
		<text name="md_lbl_developer, md_lbl_publisher, md_lbl_lastplayed, md_lbl_playcount, md_lbl_players, md_lbl_releasedate, md_lbl_rating, md_lbl_genre, md_developer, md_publisher, md_name, md_description, md_genre, md_players, md_playcount">
			<visible>false</visible>
		</text>
		<datetime name="md_lastplayed, md_releasedate">
			<visible>false</visible>
		</datetime>
		<rating name="md_rating">
			<visible>false</visible>
		</rating>
		<image name="md_image, md_flag">
			<visible>false</visible>
		</image>
		<gridtile name="default">
			<padding>0</padding>
			<backgroundColor>00000000</backgroundColor>
			<backgroundCenterColor>00000000</backgroundCenterColor>
			<backgroundEdgeColor>00000000</backgroundEdgeColor>
		</gridtile>
		<gridtile name="selected">
			<padding>0</padding>
			<backgroundColor>00000000</backgroundColor>
			<backgroundCenterColor>00000000</backgroundCenterColor>
			<backgroundEdgeColor>00000000</backgroundEdgeColor>
		</gridtile>
		<image name="gridtile.marquee, gridtile.marquee:selected, gridtile.favorite, gridtile.favorite:selected, gridtile.image">
			<visible>false</visible>
		</image>
		<image name="grid_capture, defautfanartextra" extra="true">
			<visible>false</visible>
		</image>
		<video name="grid_video" extra="true">
			<visible>false</visible>
		</video>
		<text name="base_retourtexte" extra="true">
			<visible>false</visible>
		</text>
		<image name="base_retourconsole" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${firstsystemhardware}</path>
			<pos>0.7 0.5</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.4 0.5</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>5</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
			</storyboard>
		</image>
		<control name="fanart_extra,screenshot_extra,video_extra">
			<visible>false</visible>
		</control>
		<image name="md_image">
			<visible>false</visible>
		</image>
		<image name="defautfanart" extra="true">
			<visible>(${media_fanart_missing}) &amp;&amp; {game:rom} != '..'</visible>
			<path>${intfanartfresh}</path>
			<autoFade>false</autoFade>
			<pos>0.5 0.5</pos>
			<size>0 1</size>
			<opacity>0.5</opacity>
			<saturation>1</saturation>
			<origin>0.5 0.5</origin>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="fanart" extra="true">
			<visible>${media_fanart_exists}</visible>
			<path>${media_fanart}</path>
			<autoFade>false</autoFade>
			<pos>0 0</pos>
			<pos ifSubset="perfmachine:perflow">0.5 0.5</pos>
			<size>1 1</size>
			<size ifSubset="perfmachine:perflow">0 1</size>
			<origin>0 0</origin>
			<origin ifSubset="perfmachine:perflow">0.5 0.5</origin>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/fanart_bord_repete.glsl</path>
				<hauteur>0.8</hauteur>
				<decalageHaut>0</decalageHaut>
				<bande>0.12</bande>
				<flou>32</flou>
				<assombrir>0.3</assombrir>
				<distanceFond>350</distanceFond>
				<saturationFond>0.8</saturationFond>
				<transition>70</transition>
				<vignettage>0.25</vignettage>
			</shader>
		</image>
		<image name="overlayvignettage" extra="true">
			<path>${themePath}/_viewgame/fanartstar/overlay.png</path>
			<size>1 1</size>
			<flipX>true</flipX>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>30</zIndex>
		</image>
		<image name="overlayastro" extra="true">
			<path>${themePath}/_viewgame/fanartstar/overlayAstro.png</path>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>9</zIndex>
			<opacity>0.8</opacity>
		</image>
		<image name="logosytemgamelistshadow" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.94 0.045</pos>
			<path>firstfile("${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + "-" + {game:region} + ".png",
			"${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + ".png")</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<color>000000</color>
			<zIndex>80</zIndex>
		</image>
		<image name="logosytemgamelist" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.94 0.045</pos>
			<path>firstfile("${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + "-" + {game:region} + ".png",
			"${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + ".png")</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<zIndex>80</zIndex>
		</image>
		<image name="screenshotgames" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<path>${media_image}</path>
			<pos>0.98 0.375</pos>
			<maxSize ifSubset="starvideo:starvideobig">0.4 0.54</maxSize>
			<maxSize ifSubset="starvideo:starvideodef">0.3 0.54</maxSize>
			<origin>1 0.5</origin>
			<zIndex>79</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/border_cadre.glsl</path>
				<cornerRadius>0</cornerRadius>
				<borderSize>0.01</borderSize>
				<borderColor>000000</borderColor>
				<innerShadowSize>0.05</innerShadowSize>
				<innerShadowColor>00000010</innerShadowColor>
				<outerShadowSize>0.02</outerShadowSize>
				<outerShadowColor>00000090</outerShadowColor>
			</shader>
			<storyboard event="open">
				<animation property="opacity" to="1" duration="20" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="1" duration="0" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="1200" duration="300" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="1" duration="0" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="1200" duration="300" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="50" duration="0" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="50" duration="0" mode="linear"/>
			</storyboard>
		</image>
		<video name="videogameplay" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<path>${media_video}</path>
			<delay>0.5</delay>
			<pos>0.98 0.375</pos>
			<maxSize ifSubset="starvideo:starvideobig">0.4 0.54</maxSize>
			<maxSize ifSubset="starvideo:starvideodef">0.3 0.54</maxSize>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>80</zIndex>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/border_cadre.glsl</path>
				<cornerRadius>0</cornerRadius>
				<borderSize>0.01</borderSize>
				<borderColor>000000</borderColor>
				<innerShadowSize>0.05</innerShadowSize>
				<innerShadowColor>00000010</innerShadowColor>
				<outerShadowSize>0.02</outerShadowSize>
				<outerShadowColor>00000090</outerShadowColor>
			</shader>
			<storyboard event="open">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
		</video>
		<image name="screenshotgames" ifSubset="starvideo:starvideoang" extra="true">
			<path>${media_image}</path>
			<pos>0.995 0.35</pos>
			<size>0.38 0.47</size>
			<origin>1 0.5</origin>
			<zIndex>79</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
			<storyboard event="open">
				<animation property="opacity" to="1" duration="20" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="1" duration="0" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="1200" duration="300" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="1" duration="0" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="1200" duration="300" mode="easeIn"/>
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="50" duration="0" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="50" duration="0" mode="linear"/>
			</storyboard>
		</image>
		<image name="screenshotgames_cadre" ifSubset="starvideo:starvideoang" extra="true">
			<path>${themePath}/_viewgame/fanartstar/169alt1.png</path>
			<pos>1 0.35</pos>
			<size>0.39 0.505</size>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>89</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
		</image>
		<image name="screenshotgames_fond" ifSubset="starvideo:starvideoang" extra="true">
			<path>${themePath}/_viewgame/fanartstar/fiber.png</path>
			<pos>0.995 0.35</pos>
			<size>0.38 0.472</size>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>55</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
		</image>
		<video name="videogameplay" ifSubset="starvideo:starvideoang" extra="true">
			<path>${media_video}</path>
			<delay>0.5</delay>
			<pos>0.995 0.35</pos>
			<size>0.38 0.47</size>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>80</zIndex>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
			<storyboard event="open">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="shader.time" from="0" to="3600" begin="0" duration="3600000" mode="linear"/>
			</storyboard>
		</video>
		<control name="screenshotgames,screenshotgames_cadre,screenshotgames_fond,videogameplay" ifSubset="starvideo:starvideoang">
			<offsetX>0.038</offsetX>
			<offsetX ifSubset="perfmachine:perflow">-0.01</offsetX>
			<offsetX ifSubset="perfmachine:perfnormal">0.038</offsetX>
		</control>
		<image name="marqueetitre" extra="true">
			<autoFade>false</autoFade>
			<pos>0.2 0.2</pos>
			<origin>0.5 1</origin>
			<maxSize>0.25 0.18</maxSize>
			<path>${media_marquee}</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>80</zIndex>
			<horizontalAlignment>left</horizontalAlignment>
		</image>
		<text name="gamename" extra="true">
			<visible>{game:rom} != '..'</visible>
			<text>${titrejeulangue}</text>
			<opacity>0.7</opacity>
			<pos>0.253 0.238</pos>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<fontSize>0.025</fontSize>
			<color>ffffffff</color>
			<origin>0.5 0.5</origin>
			<size>0.4 0.02</size>
			<alignment>left</alignment>
			<glowColor>00000016</glowColor>
			<glowSize>3</glowSize>
			<zIndex>305</zIndex>
		</text>
		<image name="starretourfond" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${themePath}/_viewgame/commun/retour/retour_fond.jpg</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 1</minSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="starretourconsole" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${firstsystemhardware}</path>
			<pos>0.80 0.36</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.32 0.42</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>80</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
				<animation property="x" from="0.83" to="0.80" duration="500" mode="easeOut"/>
			</storyboard>
		</image>
		<image name="starretourfleche" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${themePath}/_viewgame/commun/retour/retour.png</path>
			<pos>0.053 0.238</pos>
			<origin>0 0.5</origin>
			<maxSize>0.012 0.022</maxSize>
			<color>FFFFFFE6</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>305</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOut"/>
			</storyboard>
		</image>
		<text name="starretourtexte" extra="true">
			<visible>{game:rom} == '..'</visible>
			<text>${retourdossier}</text>
			<opacity>0.9</opacity>
			<pos>0.268 0.238</pos>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<fontSize>0.025</fontSize>
			<color>ffffffff</color>
			<origin>0.5 0.5</origin>
			<size>0.4 0.02</size>
			<alignment>left</alignment>
			<glowColor>00000016</glowColor>
			<glowSize>3</glowSize>
			<zIndex>305</zIndex>
		</text>
		<text name="md_description">
			<visible>false</visible>
		</text>
		<text name="stardescription" extra="true">
			<text>{game:desc}</text>
			<fontPath>${themePath}/_viewgame/fanartstar/OpenSans_Condensed-Bold.ttf</fontPath>
			<color>ffffffff</color>
			<pos>0.0525 0.305</pos>
			<size>0.3 0.14</size>
			<alignment>left</alignment>
			<fontSize>0.022</fontSize>
			<glowColor>00000040</glowColor>
			<glowOffset>0.8</glowOffset>
			<glowSize>2</glowSize>
			<lineSpacing>1.2</lineSpacing>
			<visible>{game:rom} != '..'</visible>
			<autoScroll>vertical</autoScroll>
			<verticalAlignment>top</verticalAlignment>
			<zIndex>305</zIndex>
		</text>
		<image name="manufacturer" extra="true">
			<autoFade>false</autoFade>
			<origin>0.5 0.5</origin>
			<pos>0.06 0.54</pos>
			<path>${extmanufacturer}</path>
			<path if="${system.manufacturer} == 'Collections'">${extgamesyst}</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>right</horizontalAlignment>
			<verticalAlignment>bottom</verticalAlignment>
			<opacity>0</opacity>
			<zIndex>305</zIndex>
			<storyboard event="open">
				<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" to="1" begin="300" duration="550" mode="Linear"/>
				<animation property="offsetX" from="-0.1" begin="300" duration="350" mode="Linear"/>
			</storyboard>
			<storyboard event="deactivate">
				<animation property="opacity" to="0" begin="" duration="" mode="Linear"/>
				<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
			</storyboard>
		</image>
		<image name="playblack" extra="true">
			<tile>false</tile>
			<origin>0.5 0.5</origin>
			<pos>0.085 0.28</pos>
			<maxSize>0.085 0.085</maxSize>
