<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${fanartsource} : champ du gamelist où chercher la fanart (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart »)
	${firstsystemhardware} : Vue système classique, option Hardware : console, sinon personnage du système (définie dans theme.xml)
	${intfanartfresh} : Fanart du système (dossier fresh) (définie dans theme.xml)
	${intlogoclearpng} : Logo clair du système (définie dans theme.xml)
	${media_box2d} : boîte 2D du jeu (gamelist ou média perso selon l option) (définie dans _viewgameoption/gl-common/gamemedia/3dinboxart.xml, _viewgameoption/gl-common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_box3d} : boîte 3D du jeu (gamelist ou média perso selon l option) (définie dans _viewgameoption/gl-common/gamemedia/3dinboxart.xml, _viewgameoption/gl-common/gamemedia/3dinthumbnail.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour la boîte 3D » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart} : fanart du jeu (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart_exists} : vrai si le média « fanart » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart_missing} : vrai si le média « fanart » du jeu manque (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart_orthumb} : média « fanart_orthumb » du jeu (gamelist ou média perso selon l option) (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_image} : capture du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_marquee} : logo du jeu (marquee) (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_marquee_missing} : vrai si le média « marquee » du jeu manque (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_video} : vidéo du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_video_exists} : vrai si le média « video » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_wheel} : logo « wheel » du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${noteicone} : icône de notation (étoile, cœur, manette...) (définie dans _viewgameoption/gl-common/options_note.xml ; valeur selon l option « JEUX - Icône de notation »)
	${path_syst_logo} : dossier des logos des systèmes (définie dans theme.xml ; valeur selon l option « AVANCÉ - Emplacement des logos des systèmes »)
	${selopacite} : opacité des jeux non sélectionnés dans les grilles (1, 0.7 ou 0.45) (définie dans ce fichier ; valeur selon l option « JEUX - Mise en valeur du jeu sélectionné »)
	${titrejeu} : valeur : {game:name} (définie dans _viewgameoption/gl-common/options_nom.xml ; valeur selon l option « JEUX - Nom du jeu »)
	Libellés traduits (_common/_langs/<langue>.xml) : ${nodates}, ${nogametime}, ${noplayerdata}, ${noratings}, ${notesur100}, ${playcount}, ${playcountone}, ${player}, ${playerss}, ${presetsquare}, ${presgame1}, ${presgame2}, ${presgame3}, ${presgame4}, ${retourdossier}
-->
<theme>
	<formatVersion>7</formatVersion>
	<variables>
		<selopacite ifSubset="selectionvaleur:legere">0.7</selopacite>
		<selopacite ifSubset="selectionvaleur:marquee">0.45</selopacite>
		<selopacite ifSubset="selectionvaleur:aucune">1</selopacite>
	</variables>
	<customView name="presetsquare" displayName="${presetsquare}" inherits="grid">
		<control name="fanart_extra, defautfanartextra">
			<visible>false</visible>
		</control>
		<imagegrid name="gamegrid">
			<pos>0.02 0.75</pos>
			<pos ifHelpPrompts="true">0.02 0.735</pos>
			<size>0.97 0.35</size>
			<scrollDirection>vertical</scrollDirection>
			<autoLayout>9 1</autoLayout>
			<padding>0.03 0.05 0.03 0.12</padding>
			<margin>0.001 0.06</margin>
			<imageSource>${fanartsource}</imageSource>
			<scrollbarColor>808080FF</scrollbarColor>
			<scrollbarCorner>0</scrollbarCorner>
			<scrollbarSize>0.003</scrollbarSize>
			<autoLayoutSelectedZoom>1.2</autoLayoutSelectedZoom>
			<margin>-0.001 0.1</margin>
			<animateSelection>false</animateSelection>
			<zIndex>50</zIndex>
			<itemTemplate ifSubset="squarecadre:noirombre|blancombre|ombre">
				<storyboard event="activate">
					<animation property="scale" to="1.2" duration="150" mode="easeOut"/>
				</storyboard>
				<storyboard event="deactivate">
					<animation property="scale" to="1" duration="250" mode="easeOut"/>
				</storyboard>
				<container>
					<image name="backgroundtile">
						<path>${media_fanart_orthumb}</path>
						<pos>0 0</pos>
						<origin>0 0</origin>
						<minSize>0.95 0.95</minSize>
						<scale>0.95</scale>
						<zIndex>3</zIndex>
						<opacity>0.7</opacity>
						<storyboard event="activate">
							<animation property="color" to="FFFFFFFF" begin="" duration="150" mode="Linear"/>
							<animation property="opacity" to="1" begin="" duration="150" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="color" to="858585ff" begin="" duration="250" mode="Linear"/>
							<animation property="opacity" to="0.7" begin="" duration="150" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="color" to="858585ff" begin="" duration="250" mode="Linear"/>
						</storyboard>
					</image>
					<image name="nofanart">
						<opacity>${selopacite}</opacity>
						<visible>${media_fanart_missing}</visible>
						<path>${intfanartfresh}</path>
						<saturation>0</saturation>
						<pos>0 0</pos>
						<origin>0 0</origin>
						<minSize>0.95 0.95</minSize>
						<scale>0.95</scale>
						<zIndex>3</zIndex>
						<storyboard event="activate">
							<animation property="color" to="FFFFFFFF" begin="" duration="150" mode="Linear"/>
							<animation property="opacity" to="1" duration="200" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="color" to="858585ff" begin="" duration="250" mode="Linear"/>
							<animation property="opacity" to="${selopacite}" duration="200" mode="easeOut"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="color" to="858585ff" begin="" duration="250" mode="Linear"/>
						</storyboard>
					</image>
					<image name="cadre">
						<opacity>${selopacite}</opacity>
						<path ifSubset="squarecadre:ombre">${themePath}/_viewgame/fanartstar/cadresquareombre.png</path>
						<path ifSubset="squarecadre:blancombre">${themePath}/_viewgame/fanartstar/cadresquareblanc.png</path>
						<path ifSubset="squarecadre:noirombre">${themePath}/_viewgame/fanartstar/cadresquarenoir.png</path>
						<pos ifSubset="squarecadre:ombre">-0.036 -0.02</pos>
						<pos ifSubset="squarecadre:blancombre">-0.05 -0.055</pos>
						<pos ifSubset="squarecadre:noirombre">-0.05 -0.041</pos>
						<origin>0 0</origin>
						<size ifSubset="squarecadre:ombre">0.95 0.95</size>
						<size ifSubset="squarecadre:blancombre">1 1</size>
						<size ifSubset="squarecadre:noirombre">0.98 0.985</size>
						<zIndex ifSubset="squarecadre:ombre">1</zIndex>
						<zIndex ifSubset="squarecadre:noirombre|blancombre">999</zIndex>
						<storyboard event="activate">
							<animation property="opacity" to="1" duration="200" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="opacity" to="${selopacite}" duration="200" mode="easeOut"/>
						</storyboard>
					</image>
					<image name="logo" extra="true" pos="0.5" origin="0.55" maxSize="0.85" linearSmooth="true">
						<opacity>${selopacite}</opacity>
						<path>${media_marquee}</path>
						<zIndex>6</zIndex>
						<storyboard event="activate">
							<animation property="opacity" to="1" duration="200" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="opacity" to="${selopacite}" duration="200" mode="easeOut"/>
						</storyboard>
					</image>
					<text name="ifnologojeux">
						<opacity>${selopacite}</opacity>
						<visible>${media_marquee_missing}</visible>
						<storyboard event="activate">
							<animation property="opacity" to="1" duration="200" mode="easeOut"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="opacity" to="${selopacite}" duration="200" mode="easeOut"/>
						</storyboard>
						<text>${titrejeu}</text>
						<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
						<color>ffffff</color>
						<alignment>center</alignment>
						<fontSize>0.023</fontSize>
						<lineSpacing>1</lineSpacing>
						<size>0.8 0.6</size>
						<pos>0.05 0.17</pos>
						<glowColor>00000066</glowColor>
						<glowSize>2</glowSize>
						<zIndex>100</zIndex>
					</text>
					<image name="md_favorite">
						<visible>{game:favorite}</visible>
						<path>${themePath}/_viewgame/fanartstar/favorite.png</path>
						<linearSmooth>true</linearSmooth>
						<pos>0.705 0</pos>
						<zIndex>999</zIndex>
						<maxSize>0.2 0.2</maxSize>
						<opacity>${selopacite}</opacity>
						<storyboard event="open">
							<animation property="color" to="ffffff" begin="0" duration="35" mode="Linear"/>
						</storyboard>
						<storyboard event="activate">
							<animation property="color" to="ebe134" begin="0" duration="250" mode="Linear"/>
							<animation property="opacity" to="1" duration="200" mode="easeOut"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="color" to="ffffff" begin="0" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate">
							<animation property="opacity" to="${selopacite}" duration="200" mode="easeOut"/>
						</storyboard>
					</image>
				</container>
			</itemTemplate>
		</imagegrid>
		<gridtile ifSubset="squarecadre:rien" name="default">
			<backgroundCenterColor>FFFFFF00</backgroundCenterColor>
			<backgroundEdgeColor>FFFFFF00</backgroundEdgeColor>
			<opacity>0.8</opacity>
			<backgroundCornerSize>0 0</backgroundCornerSize>
			<padding>5 5</padding>
			<imageSizeMode>minSize</imageSizeMode>
			<imageColor>FFFFFFAA</imageColor>
		</gridtile>
		<gridtile ifSubset="squarecadre:rien" name="selected">
			<backgroundEdgeColor>FFFFFF</backgroundEdgeColor>
			<backgroundCornerSize>0</backgroundCornerSize>
			<imageColor>FFFFFFFF</imageColor>
			<padding>3 3</padding>
		</gridtile>
		<image ifSubset="squarecadre:rien" name="gridtile.marquee">
			<pos>0.5 0.4</pos>
			<origin>0.5 0.5</origin>
			<size>0.90 0.90</size>
		</image>
		<image ifSubset="squarecadre:rien" name="gridtile.marquee:selected">
			<pos>0.5 0.5</pos>
			<color>FFFFFFFF</color>
			<size>0.75 0.75</size>
		</image>
		<image ifSubset="squarecadre:rien" name="gridtile.marquee:videoplaying">
			<color>FFFFFFA0</color>
			<pos>0.5 0.17</pos>
			<size>0.50 0.25</size>
		</image>
		<image ifSubset="squarecadre:rien" name="gridtile.favorite">
			<color>ffff00</color>
			<path>${themePath}/_viewgame/fanartstar/favorite.png</path>
			<pos>0.9 0.10</pos>
			<maxSize>0.2 0.2</maxSize>
			<origin>0.5 0.5</origin>
			<horizontalAlignment>right</horizontalAlignment>
		</image>
		<image ifSubset="squarecadre:rien" name="gridtile.favorite:selected">
			<color>ffffff</color>
		</image>
		<image name="defautfanart" extra="true">
			<visible>(${media_fanart_missing}) &amp;&amp; {game:rom} != '..'</visible>
			<path>${intfanartfresh}</path>
			<autoFade>false</autoFade>
			<pos>0.5 0.5</pos>
			<size>0 1</size>
			<opacity>0.5</opacity>
			<saturation>0</saturation>
			<origin>0.5 0.5</origin>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="defautboxart" extra="true">
			<visible>(${media_fanart_missing}) &amp;&amp; {game:rom} != '..'</visible>
			<path ifSubset="boxorthumb:boxart">${media_box3d}</path>
			<path ifSubset="boxorthumb:thumb">${media_box2d}</path>
			<autoFade>false</autoFade>
			<pos>0.96 0.7</pos>
			<maxSize>0.4 0.6</maxSize>
			<origin>1 1</origin>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="fanart" extra="true">
			<visible>${media_fanart_exists}</visible>
			<path>${media_fanart}</path>
			<autoFade>false</autoFade>
			<pos>0.56 0.45</pos>
			<size>0 0.9</size>
			<origin>0.5 0.5</origin>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="overlayarrete" extra="true">
			<path>${themePath}/_viewgame/fanartstar/overlayarrete.png</path>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>3</zIndex>
		</image>
		<video name="md_video">
			<visible>false</visible>
		</video>
		<image name="grid_capture, grid_capturefixe" extra="true">
			<path>${media_image}</path>
			<pos>0.049 0.44</pos>
			<maxSize>0.40 0.33</maxSize>
			<origin>0 0.5</origin>
			<zIndex>3.05</zIndex>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/border_cadre.glsl</path>
				<cornerRadius>0.03</cornerRadius>
				<borderSize>0.022</borderSize>
				<borderColor>ffffff30</borderColor>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
			</shader>
		</image>
		<image name="grid_capture" extra="true">
			<visible>${media_video_exists}</visible>
			<storyboard event="open">
				<animation property="opacity" from="1" to="1" duration="0"/>
				<animation property="opacity" from="1" to="0" begin="900" duration="300" mode="easeIn"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="0"/>
				<animation property="opacity" from="1" to="0" begin="900" duration="300" mode="easeIn"/>
			</storyboard>
		</image>
		<image name="grid_capturefixe" extra="true">
			<visible>!${media_video_exists}</visible>
		</image>
		<video name="grid_video" extra="true">
			<path>${media_video}</path>
			<pos>0.049 0.44</pos>
			<maxSize>0.40 0.33</maxSize>
			<origin>0 0.5</origin>
			<delay>0.4</delay>
			<showSnapshotNoVideo>false</showSnapshotNoVideo>
			<showSnapshotDelay>false</showSnapshotDelay>
			<zIndex>3.1</zIndex>
			<effect>none</effect>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/border_cadre.glsl</path>
				<cornerRadius>0.03</cornerRadius>
				<borderSize>0.022</borderSize>
				<borderColor>ffffff30</borderColor>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
			</shader>
		</video>
		<image name="logosytemgamelistshadow" extra="true">
			<autoFade>false</autoFade>
			<origin>0.5 0.5</origin>
			<pos>0.942 0.052</pos>
			<path>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + ({game:system:theme}) + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + ({game:system:theme}) + "-" + {game:region} +".png",
					"${path_syst_logo}/clearlogos/" + ({game:system:theme}) + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + ({game:system:theme}) + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + ({game:system:theme}) + ".svg")</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>91</zIndex>
			<color>000000</color>
		</image>
		<image name="logosytemgamelist" extra="true">
			<autoFade>false</autoFade>
			<origin>0.5 0.5</origin>
			<pos>0.94 0.05</pos>
			<path>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + ({game:system:theme}) + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + ({game:system:theme}) + "-" + {game:region} +".png",
					"${path_syst_logo}/clearlogos/" + ({game:system:theme}) + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + ({game:system:theme}) + ".png",
					"${themePath}/../es-theme-carbon//art/logos/" + ({game:system:theme}) + ".svg")</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>91</zIndex>
		</image>
		<image name="md_wheel">
			<visible>false</visible>
		</image>
		<image name="logowheel" extra="true">
			<visible>{game:rom} != '..'</visible>
			<path>${media_wheel}</path>
			<pos>0.05 0.15</pos>
			<origin>0 0.5</origin>
			<maxSize>0.25 0.23</maxSize>
			<zIndex>10</zIndex>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
		</image>
		<text name="gamename" extra="true">
			<visible>{game:rom} != '..'</visible>
			<text>${titrejeu}</text>
			<opacity>0.7</opacity>
			<pos>0.252 0.63</pos>
			<fontPath>${themePath}/_viewgame/fanartstar/impact.ttf</fontPath>
			<fontSize>0.025</fontSize>
			<color>ffffffff</color>
			<origin>0.5 0.5</origin>
			<size>0.4 0.02</size>
			<alignment>left</alignment>
			<glowColor>00000016</glowColor>
			<glowSize>3</glowSize>
			<zIndex>305</zIndex>
		</text>
		<image name="retourfond" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${themePath}/_viewgame/commun/retour/retour_fond.jpg</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 1</minSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="retourlogosyst" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${intlogoclearpng}</path>
			<pos>0.05 0.16</pos>
			<origin>0 0.5</origin>
			<maxSize>0.25 0.15</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>10</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="300" mode="easeOut"/>
			</storyboard>
		</image>
		<image name="retourconsole" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${firstsystemhardware}</path>
			<pos>0.72 0.36</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.36 0.42</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>10</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
				<animation property="x" from="0.75" to="0.72" duration="500" mode="easeOut"/>
			</storyboard>
		</image>
		<image name="retourfleche" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${themePath}/_viewgame/commun/retour/retour.png</path>
			<pos>0.052 0.63</pos>
			<origin>0 0.5</origin>
			<maxSize>0.012 0.022</maxSize>
			<color>FFFFFFE6</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>305</zIndex>
