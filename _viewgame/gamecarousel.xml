<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${firstsystemhardware} : Vue système classique, option Hardware : console, sinon personnage du système (définie dans theme.xml)
	${media_fanart_orthumb} : média « fanart_orthumb » du jeu (gamelist ou média perso selon l option) (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_image} : capture du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_video} : vidéo du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${path_common} : dossier _common du thème (définie dans theme.xml)
-->
<theme>
	<formatVersion>7</formatVersion>
	<view name="gamecarousel">
		<text name="md_lbl_developer, md_lbl_publisher, md_lbl_lastplayed, md_lbl_playcount, md_lbl_players, md_lbl_releasedate, md_lbl_rating, md_lbl_genre, md_developer, md_publisher, md_name, md_description, md_genre, md_players, md_playcount">
			<visible>false</visible>
		</text>
		<datetime name="md_lastplayed, md_releasedate">
			<visible>false</visible>
		</datetime>
		<rating name="md_rating">
			<visible>false</visible>
		</rating>
		<image name="md_image, md_flag">
			<visible>false</visible>
		</image>
		<gamecarousel name="gamecarousel">
			<scrollSound ifSubset="gamewheelsound:bulle">${path_common}/scrollsound/bulle.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clic">${path_common}/scrollsound/clic.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clicgrave">${path_common}/scrollsound/clicgrave.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:frottement">${path_common}/scrollsound/frottement.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:poc">${path_common}/scrollsound/poc.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360blade">${path_common}/scrollsound/xbox360-BladeSwitch_1.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360onglet">${path_common}/scrollsound/xbox360-tab_Switch.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360focus">${path_common}/scrollsound/xbox360-vk_Focus.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360touche">${path_common}/scrollsound/xbox360-vk_Select.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360retour">${path_common}/scrollsound/xbox360-btn_backG.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360selection">${path_common}/scrollsound/xbox360-snd_buttonselect.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:wheelclic">${path_common}/scrollsound/wheelclic.wav</scrollSound>
			<type>vertical_wheel</type>
			<pos>0.4 0</pos>
			<size>1 1</size>
			<logoScale>1.2</logoScale>
			<logoSize>0.150 0.260</logoSize>
			<maxLogoCount>10</maxLogoCount>
			<logoRotation>5</logoRotation>
			<logoRotationOrigin>-5.0 0.2</logoRotationOrigin>
			<logoAlignment>center</logoAlignment>
			<imageSource>marquee</imageSource>
			<zIndex>500</zIndex>
		</gamecarousel>
		<image name="gamecarouselLogo">
			<linearSmooth>true</linearSmooth>
		</image>
		<text name="gamecarouselLogoText">
			<color>FFFFFFFF</color>
			<glowColor>000000FF</glowColor>
			<glowSize>3</glowSize>
			<lineSpacing>1.0</lineSpacing>
			<fontSize>0.025</fontSize>
		</text>
		<image name="fanart_extra" extra="true">
			<visible>{game:rom} != '..'</visible>
			<autoFade>false</autoFade>
			<path>${media_fanart_orthumb}</path>
			<pos>0.7 0.5</pos>
			<size>0 1.07</size>
			<origin>0.5 0.5</origin>
			<color>000000</color>
			<colorEnd>FFFFFFDD</colorEnd>
			<gradientType>horizontal</gradientType>
			<linearSmooth>true</linearSmooth>
			<zIndex>4</zIndex>
		</image>
		<image name="screenshot_extra" extra="true">
			<path>${media_image}</path>
			<pos>0.25 0.5</pos>
			<minSize>0.375 0.5</minSize>
			<origin>0.5 0.5</origin>
			<zIndex>100</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/border_cadre.glsl</path>
				<cornerRadius>0.03</cornerRadius>
				<borderSize>0.022</borderSize>
				<borderColor>ffffff30</borderColor>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
			</shader>
			<storyboard event="open">
				<animation property="opacity" to="1" duration="20" mode="easeIn"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="1" mode="easeIn"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="500" duration="300" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="1" mode="easeIn"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="500" duration="300" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="60" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="60" mode="easeIn"/>
			</storyboard>
		</image>
		<video name="video_extra" extra="true">
			<path>${media_video}</path>
			<delay>0.4</delay>
			<pos>0.25 0.5</pos>
			<minSize>0.375 0.5</minSize>
			<origin>0.5 0.5</origin>
			<zIndex>101</zIndex>
			<effect>none</effect>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/border_cadre.glsl</path>
				<cornerRadius>0.03</cornerRadius>
				<borderSize>0.022</borderSize>
				<borderColor>ffffff30</borderColor>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
			</shader>
		</video>
		<image name="base_retourfond" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${themePath}/_viewgame/commun/retour/retour_fond.jpg</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 1</minSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>3</zIndex>
		</image>
		<image name="base_retourconsole" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${firstsystemhardware}</path>
			<pos>0.7 0.5</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.4 0.5</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>5</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
			</storyboard>
		</image>
	</view>
</theme>
