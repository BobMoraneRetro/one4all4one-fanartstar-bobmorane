<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables utilisées dans ce fichier :
	${extgameartpng} : Wheel art du jeu dans roms/système/@Media/wheel - Art (définie dans theme.xml)
	${extgamesyst} : Logo clair du système du jeu (collections : système d'origine du jeu) (définie dans theme.xml)
	${extlogoclear} : Logo clair du système (même fichier que intlogoclearpng) (définie dans theme.xml)
	${firstsystemhardware} : Vue système classique, option Hardware : console, sinon personnage du système (définie dans theme.xml)
	${intfanartfresh} : Fanart du système (dossier fresh) (définie dans theme.xml)
	${intlogoclearpng} : Logo clair du système (définie dans theme.xml)
	${media_fanart} : fanart du jeu (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart_exists} : vrai si le média « fanart » du jeu existe (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_fanart_missing} : vrai si le média « fanart » du jeu manque (définie dans _viewgameoption/gl-common/gamemedia/fanartinfanart.xml, _viewgameoption/gl-common/gamemedia/fanartinimage.xml ; fichier choisi par l option « AVANCÉ - Champ du gamelist utilisé pour le fanart » ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_marquee} : logo du jeu (marquee) (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${media_video} : vidéo du jeu (définie dans _viewgameoption/gl-common/gamemedia/medias.xml ; valeur selon l option « AVANCÉ - Médias perso des jeux »)
	${path_common} : dossier _common du thème (définie dans theme.xml)
-->
<theme>
	<formatVersion>7</formatVersion>
	<view name="detailed">
		<text name="md_lbl_developer, md_lbl_publisher, md_lbl_lastplayed, md_lbl_playcount, md_lbl_players, md_lbl_releasedate, md_lbl_rating, md_lbl_genre, md_developer, md_publisher, md_name, md_flag, md_description, md_genre, md_players, md_playcount">
			<visible>false</visible>
		</text>
		<datetime name="md_lastplayed, md_releasedate">
			<visible>false</visible>
		</datetime>
		<rating name="md_rating">
			<visible>false</visible>
		</rating>
		<image name="md_image">
			<visible>false</visible>
		</image>
		<textlist name="gamelist">
			<scrollSound ifSubset="gamewheelsound:bulle">${path_common}/scrollsound/bulle.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clic">${path_common}/scrollsound/clic.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clicgrave">${path_common}/scrollsound/clicgrave.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:frottement">${path_common}/scrollsound/frottement.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:poc">${path_common}/scrollsound/poc.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360blade">${path_common}/scrollsound/xbox360-BladeSwitch_1.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360onglet">${path_common}/scrollsound/xbox360-tab_Switch.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360focus">${path_common}/scrollsound/xbox360-vk_Focus.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360touche">${path_common}/scrollsound/xbox360-vk_Select.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360retour">${path_common}/scrollsound/xbox360-btn_backG.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:xbox360selection">${path_common}/scrollsound/xbox360-snd_buttonselect.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:wheelclic">${path_common}/scrollsound/wheelclic.wav</scrollSound>
			<pos>0.025 0.6</pos>
			<size>0.55 0.35</size>
			<lines>17</lines>
			<horizontalMargin>0.005</horizontalMargin>
			<scrollbarColor>96969620</scrollbarColor>
			<scrollbarCorner>0.49</scrollbarCorner>
			<scrollbarSize>0.0065</scrollbarSize>
			<scrollbarAlignment>outerright</scrollbarAlignment>
			<itemTemplate>
				<image name="selectionBackground">
					<path>${themePath}/_viewgame/detailed/white.png</path>
					<color>transparent</color>
					<roundCorners>8</roundCorners>
					<storyboard event="activate">
						<animation property="color" to="660d06"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="transparent"/>
					</storyboard>
					<container>
						<padding>6 0</padding>
						<text name="nameId" pos="0 0" size="1 1">
							<text>{grid:label}</text>
							<size>0.48 1</size>
							<extraTextColor>606060</extraTextColor>
							<verticalAlignment>center</verticalAlignment>
							<fontPath>${themePath}/_viewgame/detailed/Cabin-Regular.ttf</fontPath>
							<multiLine>false</multiLine>
							<autoScrollDelay>250</autoScrollDelay>
							<fontSize>0.020</fontSize>
							<color>C0C0C0</color>
							<storyboard event="activate">
								<animation property="color" to="FFFFFFFF"/>
								<animation property="singleLineScroll" to="true"/>
							</storyboard>
							<storyboard event="deactivate">
								<animation property="color" to="C0C0C0"/>
								<animation property="singleLineScroll" to="false"/>
							</storyboard>
						</text>
						<text name="genreId" pos="0.5 0" size="0.2 1">
							<text>{game:genre}</text>
							<verticalAlignment>center</verticalAlignment>
							<alignment>left</alignment>
							<fontPath>${themePath}/_viewgame/detailed/Cabin-Regular.ttf</fontPath>
							<fontSize>0.016</fontSize>
							<color>A0A0A0</color>
							<multiLine>false</multiLine>
							<autoScrollDelay>250</autoScrollDelay>
							<storyboard event="activate">
								<animation property="singleLineScroll" to="true"/>
							</storyboard>
							<storyboard event="deactivate">
								<animation property="singleLineScroll" to="false"/>
							</storyboard>
						</text>
						<text name="publisherId" pos="0.7 0" size="0.2 1">
							<text>{game:publisher}</text>
							<verticalAlignment>center</verticalAlignment>
							<alignment>left</alignment>
							<fontPath>${themePath}/_viewgame/detailed/Cabin-Regular.ttf</fontPath>
							<fontSize>0.016</fontSize>
							<color>A0A0A0</color>
							<multiLine>false</multiLine>
							<autoScrollDelay>250</autoScrollDelay>
							<storyboard event="activate">
								<animation property="singleLineScroll" to="true"/>
							</storyboard>
							<storyboard event="deactivate">
								<animation property="singleLineScroll" to="false"/>
							</storyboard>
						</text>
						<text name="releasedateId" pos="0.9 0" size="0.1 1">
							<text>{game:stars}</text>
							<verticalAlignment>center</verticalAlignment>
							<alignment>left</alignment>
							<fontPath>${themePath}/_viewgame/detailed/Cabin-Regular.ttf</fontPath>
							<fontSize>0.016</fontSize>
							<color>FFCC00D0</color>
							<multiLine>false</multiLine>
							<autoScrollDelay>250</autoScrollDelay>
							<storyboard event="activate">
								<animation property="singleLineScroll" to="true"/>
							</storyboard>
							<storyboard event="deactivate">
								<animation property="singleLineScroll" to="false"/>
							</storyboard>
						</text>
					</container>
				</image>
			</itemTemplate>
		</textlist>
		<image name="fanartPresetback" if="{system.theme} == 'windows'
			|| {system.theme} == 'switch'" extra="true">
			<visible>(${media_fanart_exists}) &amp;&amp; {game:rom} != '..'</visible>
			<autoFade>false</autoFade>
			<path>${media_fanart}</path>
			<linearSmooth>true</linearSmooth>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<maxSize>2 1</maxSize>
			<color>FFFFFFDD</color>
			<colorEnd>000000</colorEnd>
			<gradientType>vertical</gradientType>
			<zIndex>1</zIndex>
			<opacity>1</opacity>
		</image>
		<screenshader name="blur" if="{system.theme} == 'windows'
			|| {system.theme} == 'switch'" extra="true">
			<visible>{game:rom} != '..'</visible>
			<path>:/shaders/blur.glsl</path>
			<size>1 1</size>
			<pos>0 0</pos>
			<blur>16</blur>
			<zIndex>2</zIndex>
			<blurColor>000000</blurColor>
		</screenshader>
		<image name="BackifNofanart" extra="true">
			<visible>(${media_fanart_missing}) &amp;&amp; {game:rom} != '..'</visible>
			<autoFade>false</autoFade>
			<path>${intfanartfresh}</path>
			<opacity>0.5</opacity>
			<saturation>0</saturation>
			<linearSmooth>true</linearSmooth>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<maxSize>2 1</maxSize>
			<color>FFFFFFDD</color>
			<colorEnd>000000</colorEnd>
			<gradientType>vertical</gradientType>
			<zIndex>2</zIndex>
		</image>
		<image name="fanartPreset" extra="true">
			<visible>(${media_fanart_exists}) &amp;&amp; {game:rom} != '..'</visible>
			<path>${media_fanart}</path>
			<autoFade>false</autoFade>
			<linearSmooth>true</linearSmooth>
			<pos>0.5 0.5</pos>
			<pos if="{system.theme} == 'windows'
			|| {system.theme} == 'switch'">0.5 0.35</pos>
			<origin>0.5 0.5</origin>
			<maxSize>2 1</maxSize>
			<maxSize if="{system.theme} == 'windows'
			|| {system.theme} == 'switch'">1 1</maxSize>
			<color>FFFFFFDD</color>
			<colorEnd>000000</colorEnd>
			<gradientType>vertical</gradientType>
			<zIndex>2</zIndex>
			<shader ifSubset="perfmachine:perfnormal" if="{system.theme} == 'windows'
			|| {system.theme} == 'switch'">
				<path>${themePath}/_common/shaders/border_cadre.glsl</path>
				<cornerRadius>1</cornerRadius>
				<borderSize>0.005</borderSize>
				<borderColor>000000</borderColor>
				<innerShadowSize>0.02</innerShadowSize>
				<innerShadowColor>000000</innerShadowColor>
				<outerShadowSize>0.02</outerShadowSize>
				<outerShadowColor>000000</outerShadowColor>
			</shader>
		</image>
		<image name="fond black" extra="true">
			<tile>false</tile>
			<pos>0.1 0</pos>
			<maxSize>0.5 0.5</maxSize>
			<opacity>0.5</opacity>
			<origin>0.5 0.5</origin>
			<zIndex>90</zIndex>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<path>${themePath}/_viewgame/detailed/gradient_black.png</path>
		</image>
		<image name="marqueetitre" extra="true">
			<pos>0.15 0.12</pos>
			<maxSize>0.25 0.2</maxSize>
			<origin>0.5 0.5</origin>
			<path>${media_marquee}</path>
			<path if="{system.theme} == 'switch'">${extgameartpng}</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>91</zIndex>
		</image>
		<image name="logosytemcollectionlist" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.355 0.04</pos>
			<path if="${system.manufacturer} == 'Collections'">${extgamesyst}</path>
			<maxSize>0.1 0.05</maxSize>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>right</horizontalAlignment>
			<zIndex>100</zIndex>
		</image>
		<text name="metadata" extra="true">
			<visible>{game:rom} != '..'</visible>
			<pos>0.028 0.555</pos>
			<size>0.4 0.05</size>
			<text>Joueurs : {game:players} | Parties : {game:playcount} | Langues : {game:lang}</text>
			<alignment>left</alignment>
			<fontSize>0.020</fontSize>
			<color>C0C0C0</color>
			<fontPath>${themePath}/_viewgame/detailed/Cabin-Regular.ttf</fontPath>
		</text>
		<video name="PreviewVid" extra="true">
			<path>${media_video}</path>
			<delay>0.3</delay>
			<origin>0.5 0.5</origin>
			<pos>0.78 0.778</pos>
			<maxSize>0.4 0.35</maxSize>
			<zIndex>10</zIndex>
			<effect>none</effect>
			<shader ifSubset="perfmachine:perfnormal">
				<path>${themePath}/_common/shaders/border_cadre.glsl</path>
				<cornerRadius>0.03</cornerRadius>
				<borderSize>0.022</borderSize>
				<borderColor>ffffff30</borderColor>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
			</shader>
		</video>
		<image name="LogoSytemgamelistShadow" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.942 0.052</pos>
			<path>${intlogoclearpng}</path>
			<path>${extlogoclear}</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<zIndex>80</zIndex>
			<color>000000</color>
		</image>
		<image name="LogoSytemgamelist" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.94 0.05</pos>
			<path>${intlogoclearpng}</path>
			<path>${extlogoclear}</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<zIndex>80</zIndex>
		</image>
		<image name="base_retourfond" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${themePath}/_viewgame/commun/retour/retour_fond.jpg</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 1</minSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>2</zIndex>
		</image>
		<image name="base_retourconsole" extra="true">
			<visible>{game:rom} == '..'</visible>
			<path>${firstsystemhardware}</path>
			<pos>0.78 0.55</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.36 0.4</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>11</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
			</storyboard>
			<storyboard event="activate">
				<animation property="opacity" from="0" to="1" duration="400" mode="easeOut"/>
			</storyboard>
		</image>
	</view>
</theme>
